 "font_size": 14,
 "html": "<style>\r\n.hecf {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 9.5pt;\r\n    color: #000;\r\n    line-height: 1.3;\r\n}\r\n.hecf h1 {\r\n    text-align: center;\r\n    font-size: 13pt;\r\n    font-weight: bold;\r\n    margin: 0 0 8px 0;\r\n}\r\n.hecf table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n    margin-bottom: 6px;\r\n}\r\n.hecf table td, .hecf table th {\r\n    border: 1px solid #000;\r\n    padding: 3px 6px;\r\n    vertical-align: middle;\r\n    word-wrap: break-word;\r\n}\r\n.hecf .section-title {\r\n    background: #eeeeee;\r\n    font-weight: bold;\r\n    padding: 3px 6px;\r\n}\r\n.hecf .col-header {\r\n    background: #f5f5f5;\r\n    font-weight: bold;\r\n    text-align: center;\r\n}\r\n.hecf .fill {\r\n    display: inline-block;\r\n    border-bottom: 1px solid #000;\r\n    min-width: 60%;\r\n    padding: 0 2px 1px 4px;\r\n}\r\n.hecf .checklist td:nth-child(1) { width: 18%; font-weight: bold; }\r\n.hecf .checklist td:nth-child(2) { width: 34%; }\r\n.hecf .checklist td:nth-child(3),\r\n.hecf .checklist td:nth-child(4),\r\n.hecf .checklist td:nth-child(5) { width: 16%; text-align: center; }\r\n.hecf .confirm-cell { width: 50%; }\r\n.hecf .confirm-cell .opt { margin-right: 12px; white-space: nowrap; }\r\n.hecf .sig-cell { width: 50%; white-space: nowrap; }\r\n.hecf .remarks-box { min-height: 40px; }\r\n</style>\r\n\r\n<div class=\"hecf\">\r\n    {{ letter_head }}\r\n\r\n\t<h1>Hospital Exit Clearance Form</h1>\r\n\r\n\t<!-- Section A: Employee Information -->\r\n\t<table>\r\n\t\t<tr><td class=\"section-title\" colspan=\"2\">Section A: Employee Information</td></tr>\r\n\t\t<tr>\r\n\t\t\t<td><strong>Name:</strong> <span class=\"fill\">{{ doc.employee_name or \"\" }}</span></td>\r\n\t\t\t<td><strong>Employee ID:</strong> <span class=\"fill\">{{ doc.employee or \"\" }}</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td><strong>Department/Unit:</strong> <span class=\"fill\">{{ doc.department or \"\" }}</span></td>\r\n\t\t\t<td><strong>Position/Role:</strong> <span class=\"fill\">{{ doc.job_title or \"\" }}</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td><strong>Date of Hire:</strong> <span class=\"fill\">{{ frappe.utils.formatdate(doc.date_of_joining) if doc.date_of_joining else \"\" }}</span></td>\r\n\t\t\t<td><strong>Last Working Day:</strong> <span class=\"fill\">{{ frappe.utils.formatdate(doc.last_working_date) if doc.last_working_date else \"\" }}</span></td>\r\n\t\t</tr>\r\n\t</table>\r\n\r\n\t<!-- Section B: Clearance Checklist -->\r\n\t<table class=\"checklist\">\r\n\t\t<tr><td class=\"section-title\" colspan=\"5\">Section B: Clearance Checklist</td></tr>\r\n\t\t<tr class=\"col-header\">\r\n\t\t\t<td>Department/Unit</td>\r\n\t\t\t<td>Items to be Cleared</td>\r\n\t\t\t<td>Verified By</td>\r\n\t\t\t<td>Signature</td>\r\n\t\t\t<td>Date</td>\r\n\t\t</tr>\r\n\t\t{% for row in doc.exit_clearance_checklist_item %}\r\n\t\t<tr>\r\n\t\t\t<td>{{ row.department or \"\" }}</td>\r\n\t\t\t<td>{{ row.item_to_be_cleared or \"\" }}</td>\r\n\t\t\t<td>{{ row.verified_by or \"\" }}</td>\r\n\t\t\t<td>{{ row.signature or \"\" }}</td>\r\n\t\t\t<td>{{ frappe.utils.formatdate(row.date) if row.date else \"\" }}</td>\r\n\t\t</tr>\r\n\t\t{% endfor %}\r\n\t</table>\r\n\r\n\t<!-- Section C: Final Confirmation -->\r\n\t<table>\r\n\t\t<tr><td class=\"section-title\" colspan=\"2\">Section C: Final Confirmation</td></tr>\r\n\t\t<tr>\r\n\t\t\t<td class=\"confirm-cell\">\r\n\t\t\t\tAll hospital property returned:\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.all_hospital_property_returned == \"Yes\" else \"\u2610\" }} Yes</span>\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.all_hospital_property_returned == \"No\" else \"\u2610\" }} No</span>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"confirm-cell\">\r\n\t\t\t\tAll patient care responsibilities handed over:\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.all_patient_care_responsibilities_handed_over == \"Yes\" else \"\u2610\" }} Yes</span>\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.all_patient_care_responsibilities_handed_over == \"No\" else \"\u2610\" }} No</span>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td class=\"confirm-cell\">\r\n\t\t\t\tAll financial obligations settled:\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.all_financial_obligations_settled == \"Yes\" else \"\u2610\" }} Yes</span>\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.all_financial_obligations_settled == \"No\" else \"\u2610\" }} No</span>\r\n\t\t\t</td>\r\n\t\t\t<td class=\"confirm-cell\">\r\n\t\t\t\tHR clearance approved:\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.hr_clearance_approved == \"Yes\" else \"\u2610\" }} Yes</span>\r\n\t\t\t\t<span class=\"opt\">{{ \"\u2611\" if doc.hr_clearance_approved == \"No\" else \"\u2610\" }} No</span>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n\r\n\t<!-- Section D: Authorization (no matching fields on the doctype - printed blank for wet signature) -->\r\n\t<table>\r\n\t\t<tr><td class=\"section-title\" colspan=\"2\">Section D: Authorization</td></tr>\r\n\t\t<tr>\r\n\t\t\t<td class=\"sig-cell\">HR Officer: <span class=\"fill\" style=\"min-width:60%;\">&nbsp;</span></td>\r\n\t\t\t<td class=\"sig-cell\">Finance Officer: <span class=\"fill\" style=\"min-width:55%;\">&nbsp;</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td class=\"sig-cell\">IT Officer: <span class=\"fill\" style=\"min-width:60%;\">&nbsp;</span></td>\r\n\t\t\t<td class=\"sig-cell\">Line Manager/Supervisor: <span class=\"fill\" style=\"min-width:45%;\">&nbsp;</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td class=\"sig-cell\">HR Manager: <span class=\"fill\" style=\"min-width:55%;\">&nbsp;</span></td>\r\n\t\t\t<td class=\"sig-cell\">Hospital Director: <span class=\"fill\" style=\"min-width:50%;\">&nbsp;</span></td>\r\n\t\t</tr>\r\n\t</table>\r\n\r\n\t<!-- Section E: Remarks -->\r\n\t<table>\r\n\t\t<tr><td class=\"section-title\">Section E: Remarks</td></tr>\r\n\t\t<tr><td class=\"remarks-box\">{{ doc.remarks or \"\" }}</td></tr>\r\n\t</table>\r\n\r\n</div>",
