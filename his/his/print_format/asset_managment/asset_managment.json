 "html": "<style>\r\n    .print-format {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 12px;\r\n        color: #333;\r\n        padding: 10px;\r\n    }\r\n\r\n    .print-format .patient-box {\r\n        border: 1px solid #16215c;\r\n        border-radius: 8px;\r\n        padding: 8px 15px !important;\r\n        margin-bottom: 10px;\r\n        background-color: #fbf6ef;\r\n    }\r\n\r\n    .print-format .patient-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .print-format .patient-table td {\r\n        border: none;\r\n        vertical-align: top;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        padding: 0 !important;\r\n    }\r\n\r\n    .print-format .report-title {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        font-weight: 800;\r\n        color: #16215c;\r\n        letter-spacing: 3px;\r\n        margin-top: 10px;\r\n        margin-bottom: 4px;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .print-format .report-title-underline {\r\n        width: 160px;\r\n        height: 3px;\r\n        background-color: #f5821f;\r\n        margin: 0 auto 15px;\r\n    }\r\n\r\n    .print-format .section-title {\r\n        background: #16215c;\r\n        color: #fff;\r\n        border-radius: 6px 6px 0 0;\r\n        padding: 6px 10px !important;\r\n        font-weight: bold;\r\n        margin-top: 12px;\r\n        letter-spacing: 0.5px;\r\n    }\r\n\r\n    .print-format .field-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        border: 1px solid #ccc;\r\n        border-top: none;\r\n        border-radius: 0 0 6px 6px;\r\n        overflow: hidden;\r\n    }\r\n\r\n    .print-format .field-table td {\r\n        padding: 6px 10px !important;\r\n        font-size: 12px;\r\n        border-bottom: 1px solid #eee;\r\n    }\r\n\r\n    .print-format .field-table tr:last-child td {\r\n        border-bottom: none;\r\n    }\r\n\r\n    .print-format .field-table td.field-label {\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        width: 30%;\r\n        background: #fbf6ef;\r\n        border-right: 1px solid #eee;\r\n    }\r\n\r\n    .print-format .field-table td.field-value {\r\n        color: #333;\r\n    }\r\n\r\n    .print-format .status-pill {\r\n        display: inline-block;\r\n        margin: 0 auto 15px;\r\n        padding: 3px 14px;\r\n        border-radius: 10px;\r\n        font-size: 11px;\r\n        font-weight: bold;\r\n        letter-spacing: 0.5px;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .print-format .status-wrap { text-align: center; }\r\n\r\n    .print-format .status-submitted { background: #e4f4e8; color: #1c7a34; }\r\n    .print-format .status-draft     { background: #fdeedb; color: #b45309; }\r\n    .print-format .status-cancelled { background: #fbe4e4; color: #b91c1c; }\r\n\r\n    .print-format .sig-block {\r\n        border: 1px solid #ccc;\r\n        border-top: none;\r\n        border-radius: 0 0 6px 6px;\r\n        padding: 14px 16px;\r\n        margin-bottom: 4px;\r\n        display: flex;\r\n        gap: 24px;\r\n    }\r\n\r\n    .print-format .sig-row-full {\r\n        display: flex;\r\n        align-items: flex-end;\r\n    }\r\n\r\n    .print-format .sig-row-full.sig-name {\r\n        flex: 4;\r\n    }\r\n\r\n    .print-format .sig-row-full.sig-signature {\r\n        flex: 1;\r\n    }\r\n\r\n    .print-format .sig-label-full {\r\n        font-size: 11px;\r\n        color: #16215c;\r\n        font-weight: bold;\r\n        width: 70px;\r\n        flex-shrink: 0;\r\n        padding-bottom: 4px;\r\n    }\r\n\r\n    .print-format .sig-fill-full {\r\n        flex: 1;\r\n        border-bottom: 1px solid #a3a8b3;\r\n        min-height: 26px;\r\n        font-size: 12px;\r\n        color: #333;\r\n        padding-bottom: 3px;\r\n    }\r\n\r\n    .print-format .print-footer {\r\n        margin-top: 22px;\r\n        padding-top: 6px;\r\n        border-top: 1px solid #e5e7eb;\r\n        font-size: 9.5px;\r\n        color: #8a8f98;\r\n        text-align: center;\r\n    }\r\n</style>\r\n\r\n<main style=\"width: 700px; margin: 0 auto;\">\r\n<div class=\"print-format\">\r\n\r\n    {{ letter_head }}\r\n\r\n    <div class=\"report-title\">Fixed Asset Register</div>\r\n    <div class=\"report-title-underline\"></div>\r\n\r\n    <!-- ASSET INFO BOX -->\r\n    <div class=\"patient-box\">\r\n        <table class=\"patient-table\">\r\n            <tr>\r\n                <td width=\"50%\">\r\n                    Asset No : {{ doc.name }}<br>\r\n                    Asset Name : {{ doc.asset_name or \"\" }}<br>\r\n                    Item Name : {{ doc.item_name or \"\" }}<br>\r\n                </td>\r\n                <td width=\"50%\">\r\n                    Company : {{ doc.company or \"\" }}<br>\r\n                    Asset Category : {{ doc.asset_category or \"\" }}<br>\r\n                    Location : {{ doc.location or \"\" }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <div class=\"status-wrap\">\r\n        <span class=\"status-pill status-submitted\">Approved</span>\r\n    </div>\r\n\r\n    <!-- PURCHASE DETAILS -->\r\n    <div class=\"section-title\">Purchase Details</div>\r\n    <table class=\"field-table\">\r\n        <tr>\r\n            <td class=\"field-label\">Supplier</td>\r\n            <td class=\"field-value\">{{ doc.supplier or \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"field-label\">Purchase Date</td>\r\n            <td class=\"field-value\">{{ frappe.utils.formatdate(doc.purchase_date, \"dd-MM-yyyy\") if doc.purchase_date else \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"field-label\">Gross Purchase Amount</td>\r\n            <td class=\"field-value\">{{ frappe.utils.fmt_money(doc.gross_purchase_amount, currency=doc.get(\"currency\") or \"USD\") if doc.gross_purchase_amount is defined else \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"field-label\">Asset Quantity</td>\r\n            <td class=\"field-value\">{{ doc.asset_quantity or 1 }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- CUSTODY -->\r\n    <div class=\"section-title\">Custody &amp; Location</div>\r\n    <table class=\"field-table\">\r\n        <tr>\r\n            <td class=\"field-label\">Location</td>\r\n            <td class=\"field-value\">{{ doc.location or \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"field-label\">Custodian</td>\r\n            <td class=\"field-value\">{{ doc.custodian or \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"field-label\">Department</td>\r\n            <td class=\"field-value\">{{ doc.department or \"\" }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- SIGNATURES -->\r\n    <div class=\"section-title\">Custodian</div>\r\n    <div class=\"sig-block\">\r\n        <div class=\"sig-row-full sig-name\">\r\n            <span class=\"sig-label-full\">Name</span>\r\n            <span class=\"sig-fill-full\">{{ frappe.db.get_value(\"Employee\", doc.custodian, \"employee_name\") or \"\" }}</span>\r\n        </div>\r\n        <div class=\"sig-row-full sig-signature\">\r\n            <span class=\"sig-label-full\">Signature</span>\r\n            <span class=\"sig-fill-full\">&nbsp;</span>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section-title\">Department Head</div>\r\n    <div class=\"sig-block\">\r\n        <div class=\"sig-row-full sig-name\">\r\n            <span class=\"sig-label-full\">Name</span>\r\n            <span class=\"sig-fill-full\">&nbsp;</span>\r\n        </div>\r\n        <div class=\"sig-row-full sig-signature\">\r\n            <span class=\"sig-label-full\">Signature</span>\r\n            <span class=\"sig-fill-full\">&nbsp;</span>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section-title\">Asset Manager</div>\r\n    <div class=\"sig-block\">\r\n        <div class=\"sig-row-full sig-name\">\r\n            <span class=\"sig-label-full\">Name</span>\r\n            <span class=\"sig-fill-full\">&nbsp;</span>\r\n        </div>\r\n        <div class=\"sig-row-full sig-signature\">\r\n            <span class=\"sig-label-full\">Signature</span>\r\n            <span class=\"sig-fill-full\">&nbsp;</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- FOOTER -->\r\n    <div class=\"print-footer\">\r\n        Printed On : {{ frappe.utils.now_datetime().strftime(\"%d-%m-%Y %H:%M:%S\") }}\r\n        &nbsp;&nbsp;|&nbsp;&nbsp;\r\n        Printed By : {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") }}\r\n    </div>\r\n\r\n</div>\r\n</main>",
