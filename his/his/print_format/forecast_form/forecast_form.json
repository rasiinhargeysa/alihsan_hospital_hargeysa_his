 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!--\r\n    Forecast Form - Print Format\r\n    Paste this into: Print Format > (New) > Print Format Type = Jinja > HTML\r\n\r\n    ASSUMPTIONS (rename in the template if your fieldnames differ):\r\n      Parent fields:      department, total_income, total_expenses, profit_or_loss\r\n      Income child table: income  -> service_income, qty, qty_per_month, price, revenue, revenue_percentage\r\n      Expenses child table: expenses -> department_expenses, expense_type (Select: \"Department Expense\" / \"Other Expense\"),\r\n                                        qty, price, expense, expense_percentage\r\n-->\r\n\r\n<style>\r\n    .forecast-print * { box-sizing: border-box; }\r\n    .forecast-print {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 11px;\r\n        color: #000;\r\n    }\r\n    .forecast-print h2 {\r\n        text-align: center;\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n        background-color: #305496;\r\n        color: #fff;\r\n        padding: 6px;\r\n        margin: 18px 0 0 0;\r\n    }\r\n    .forecast-print table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 4px;\r\n    }\r\n    .forecast-print th, .forecast-print td {\r\n        border: 1px solid #999;\r\n        padding: 4px 6px;\r\n        text-align: left;\r\n    }\r\n    .forecast-print th {\r\n        background-color: #DCE6F1;\r\n        font-weight: bold;\r\n        text-align: center;\r\n    }\r\n    .forecast-print td.num, .forecast-print th.num {\r\n        text-align: right;\r\n    }\r\n    .forecast-print td.center {\r\n        text-align: center;\r\n    }\r\n    .forecast-print tr.subheader td {\r\n        background-color: #EFEFEF;\r\n        font-weight: bold;\r\n    }\r\n    .forecast-print tr.total-row td {\r\n        background-color: #FCE4D6;\r\n        font-weight: bold;\r\n    }\r\n    .forecast-print tr.grand-total-row td {\r\n        background-color: #C6E0B4;\r\n        font-weight: bold;\r\n    }\r\n</style>\r\n\r\n<div class=\"forecast-print\">\r\n\r\n    <!-- ============== LETTERHEAD / HEADER ============== -->\r\n    <table style=\"border: none; margin-bottom: 10px;\">\r\n        <tr style=\"border: none;\">\r\n            <td style=\"border: none; width: 60%;\">\r\n                <h1 style=\"margin:0; font-size:16px;\">{{ doc.company or \"\" }}</h1>\r\n               {{ letter_head }}\r\n                <div>Date: {{ frappe.utils.formatdate(doc.date) }}</div>\r\n                <div>Department: {{ doc.department }}</div>\r\n                <div>Prepared by: {{ doc.username or doc.owner }}</div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ============== INCOME SECTION ============== -->\r\n    <h2>{{ doc.department }} Forecast Income</h2>\r\n    <table>\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:5%;\">No</th>\r\n                <th>Service Income</th>\r\n                <th class=\"num\" style=\"width:10%;\">Revenue %</th>\r\n                <th class=\"num\" style=\"width:10%;\">Qty / Day</th>\r\n                <th class=\"num\" style=\"width:12%;\">Qty / Month</th>\r\n                <th class=\"num\" style=\"width:10%;\">Price</th>\r\n                <th class=\"num\" style=\"width:12%;\">Revenue</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for row in doc.income %}\r\n            <tr>\r\n                <td class=\"center\">{{ row.idx }}</td>\r\n                <td>{{ row.service_income }}</td>\r\n                <td class=\"num\">{{ \"%.2f\"|format(row.revenue_percentage|float(0)) }}%</td>\r\n                <td class=\"num\">{{ \"%.2f\"|format(row.qty|float(0)) }}</td>\r\n                <td class=\"num\">{{ \"%.2f\"|format(row.qty_per_month|float(0)) }}</td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(row.price, currency=\"USD\") }}</td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(row.revenue, currency=\"USD\") }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n            <tr class=\"total-row\">\r\n                <td colspan=\"2\">Total Revenue</td>\r\n                <td class=\"num\">100.00%</td>\r\n                <td colspan=\"3\"></td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_income, currency=\"USD\") }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ============== EXPENSES SECTION ============== -->\r\n    <h2>{{ doc.department }} Forecast Expenses</h2>\r\n    <table>\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:5%;\">No</th>\r\n                <th>Expenses Name</th>\r\n                <th class=\"num\" style=\"width:10%;\">Expense %</th>\r\n                <th class=\"num\" style=\"width:10%;\">Qty</th>\r\n                <th class=\"num\" style=\"width:10%;\">Rate</th>\r\n                <th class=\"num\" style=\"width:12%;\">Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <!-- Department Expenses -->\r\n            <!--<tr class=\"subheader\">-->\r\n            <!--    <td colspan=\"6\">Department Expenses</td>-->\r\n            <!--</tr>-->\r\n            {% set dept_total = namespace(value=0) %}\r\n            {% for row in doc.expenses %}\r\n           \r\n                <tr>\r\n                    <td class=\"center\">{{ loop.index }}</td>\r\n                    <td>{{ row.department_expenses }}</td>\r\n                    <td class=\"num\">{{ \"%.2f\"|format(row.expense_percentage|float(0)) }}%</td>\r\n                    <td class=\"num\">{{ \"%.2f\"|format(row.qty|float(0)) }}</td>\r\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.price, currency=\"USD\") }}</td>\r\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.expense, currency=\"USD\") }}</td>\r\n                </tr>\r\n             \r\n            {% endfor %}\r\n        \r\n          \r\n          \r\n\r\n            <tr class=\"grand-total-row\">\r\n                <td colspan=\"5\">Total Expenses</td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_expenses, currency=\"USD\") }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ============== SUMMARY SECTION ============== -->\r\n    <h2>{{ doc.department }} Forecast Summary</h2>\r\n    <table>\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:8%;\">No</th>\r\n                <th>Type</th>\r\n                <th class=\"num\">USD</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td class=\"center\">1</td>\r\n                <td>Total Income</td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_income, currency=\"USD\") }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"center\">2</td>\r\n                <td>Total Expenses</td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_expenses, currency=\"USD\") }}</td>\r\n            </tr>\r\n            <tr class=\"grand-total-row\">\r\n                <td colspan=\"2\">Profit and Loss</td>\r\n                <td class=\"num\">{{ frappe.utils.fmt_money(doc.profit_or_loss, currency=\"USD\") }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n</div>",
