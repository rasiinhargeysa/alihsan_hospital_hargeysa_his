 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    * { box-sizing: border-box; }\r\n\r\n    body {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        color: #000;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .print-wrapper { width: 100%; padding: 8px 18px; }\r\n\r\n    .brand-header { text-align: center; margin-bottom: 8px; }\r\n\r\n    .supplier-info { margin-bottom: 18px; font-size: 12px; color: #000; }\r\n\r\n    .supplier-name {\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n    }\r\n\r\n    .doc-title {\r\n        text-align: center;\r\n        color: #10194f;\r\n        font-size: 22px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 4px;\r\n        margin: 8px 0 4px;\r\n    }\r\n\r\n    .title-orange-line {\r\n        width: 140px;\r\n        height: 3px;\r\n        background-color: #e36c12;\r\n        margin: 8px auto 6px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .grn-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n        font-size: 13px;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .grn-row b { font-weight: bold; }\r\n\r\n    .info-section {\r\n        border: 2px solid #10194f;\r\n        border-radius: 9px;\r\n        background-color: #f7f8fb;\r\n        padding: 14px 16px;\r\n        margin-bottom: 14px;\r\n        border-top: 4px solid #e36c12;\r\n        line-height: 0.6;\r\n    }\r\n\r\n    .details-grid {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        gap: 18px;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .details-grid:last-child { margin-bottom: 0; }\r\n\r\n    .details-cell { width: 25%; font-size: 12px; }\r\n    .details-cell-half { width: 50%; font-size: 12px; }\r\n\r\n    .details-label {\r\n        color: #10194f;\r\n        font-weight: bold;\r\n        margin-bottom: 7px;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .details-value { color: #000; font-weight: normal; }\r\n\r\n    .items-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 10px;\r\n        margin-top: 10px;\r\n    }\r\n\r\n    .items-table th {\r\n        background-color: #10194f;\r\n        color: #fff;\r\n        border: 1px solid #fff;\r\n        padding: 8px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        line-height: 0.6;\r\n    }\r\n\r\n    .items-table th:first-child { border-left: 1px solid #10194f; }\r\n    .items-table th:last-child  { border-right: 1px solid #10194f; }\r\n\r\n    .items-table td {\r\n        border: 1px solid #777;\r\n        padding: 6px 8px;\r\n        vertical-align: middle;\r\n        line-height: 1.3;\r\n    }\r\n\r\n    /* Item Name column absorbs the remaining width */\r\n    .items-table th:nth-child(2),\r\n    .items-table td:nth-child(2) { width: 100%; }\r\n\r\n    .items-table tbody tr:nth-child(even) { background-color: #f7f8fb; }\r\n\r\n    .text-center { text-align: center; }\r\n    .text-right  { text-align: right; }\r\n    .nowrap      { white-space: nowrap; }\r\n\r\n    .product-name {\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        color: #000;\r\n    }\r\n\r\n    .product-desc {\r\n        font-weight: normal;\r\n        text-transform: none;\r\n        color: #444;\r\n        font-size: 9px;\r\n        margin-top: 3px;\r\n        line-height: 1.3;\r\n    }\r\n\r\n    .total-box {\r\n        width: 330px;\r\n        margin-left: auto;\r\n        margin-top: 10px;\r\n        border: 1px solid #777;\r\n    }\r\n\r\n    .total-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        background-color: #10194f;\r\n        color: #fff !important;\r\n        padding: 8px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .subtotal-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        padding: 7px 8px;\r\n        font-size: 11px;\r\n        border-bottom: 1px solid #ddd;\r\n    }\r\n\r\n    .words-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        gap: 10px;\r\n        border-top: 3px solid #e36c12;\r\n        padding: 8px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .words-row span:first-child { font-weight: bold; min-width: 95px; }\r\n\r\n    .notes-section {\r\n        margin-top: 16px;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #000;\r\n    }\r\n\r\n    .notes-section span { font-weight: normal; }\r\n\r\n    .signature-section {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 45px;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .signature-box { width: 30%; text-align: center; }\r\n\r\n    .signature-line { border-top: 1px solid #000; padding-top: 6px; }\r\n\r\n    tr { page-break-inside: avoid; }\r\n\r\n    @media print {\r\n        .print-wrapper { padding: 5px 15px; }\r\n\r\n        .items-table th,\r\n        .items-table td { padding: 6px; }\r\n\r\n        .items-table th,\r\n        .total-row,\r\n        .total-row span {\r\n            color: #fff !important;\r\n            background-color: #10194f !important;\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n\r\n        .info-section,\r\n        .items-table tbody tr:nth-child(even) {\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n    }\r\n</style>\r\n\r\n{#- Auto-detect the child table fieldname -#}\r\n{%- set _tf = frappe.get_meta(doc.doctype).get_table_fields()\r\n        | selectattr(\"options\", \"equalto\", \"Custom Purchase Order Item\")\r\n        | list -%}\r\n{%- set items = doc.get(_tf[0].fieldname) if _tf else [] -%}\r\n{%- set has_expiry = items | selectattr(\"expired_date\") | list | length > 0 -%}\r\n{%- set cur = doc.get(\"currency\") or frappe.db.get_default(\"currency\") -%}\r\n\r\n<div class=\"print-wrapper\">\r\n\r\n    <!-- Letter Head / Brand -->\r\n    <div class=\"brand-header\">\r\n        {{ letter_head }}\r\n    </div>\r\n\r\n    <!-- Supplier Info -->\r\n    <div class=\"supplier-info\">\r\n        <div class=\"supplier-name\">Supplier: {{ doc.get(\"supplier\") or \"\" }}</div>\r\n    </div>\r\n\r\n    <!-- Title -->\r\n    <div class=\"doc-title\">Purchase Order</div>\r\n    <div class=\"title-orange-line\"></div>\r\n\r\n    <!-- PO Number and Date -->\r\n    <div class=\"grn-row\">\r\n        <div>\r\n            <b>PO No.</b>\r\n            {{ doc.name or \"\" }}\r\n        </div>\r\n\r\n        <div>\r\n            <b>Dated:</b>\r\n            {{ doc.get(\"date\") or doc.get(\"transaction_date\") or \"\" }}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Brand Colored Info Section -->\r\n    <div class=\"info-section\">\r\n\r\n        <div class=\"details-grid\">\r\n            <div class=\"details-cell\">\r\n                <div class=\"details-label\">PO no.</div>\r\n                <div class=\"details-value\">\r\n                    {% if doc.name and doc.name.split(\"-\")|length > 3 %}\r\n                        {{ doc.name.split(\"-\")[3] }}\r\n                    {% else %}\r\n                        {{ doc.name or \"\" }}\r\n                    {% endif %}\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"details-cell\">\r\n                <div class=\"details-label\">Date</div>\r\n                <div class=\"details-value\">{{ doc.get(\"date\") or doc.get(\"transaction_date\") or \"\" }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"details-grid\">\r\n            <div class=\"details-cell-half\">\r\n                <div class=\"details-label\">Our Procurement Representative</div>\r\n                <div class=\"details-value\">\r\n                    {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") or \"\" }}\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"details-cell-half\">\r\n                <div class=\"details-label\">Contact number</div>\r\n                <div class=\"details-value\">\r\n                    {{ frappe.db.get_value(\"User\", frappe.session.user, \"mobile_no\") or \"-\" }}\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- Items Table -->\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 45px;\">SN.</th>\r\n                <th style=\"text-align: left;\">Item Name</th>\r\n                <th style=\"width: 60px;\">QTY</th>\r\n                <th style=\"width: 95px;\">RATE</th>\r\n                {% if has_expiry %}\r\n                <th style=\"width: 110px;\">EXPIRED</th>\r\n                {% endif %}\r\n                <th style=\"width: 110px;\">AMOUNT</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in items %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n\r\n                <td>\r\n                    <span class=\"product-name\">{{ item.item_name or \"\" }}</span>\r\n                    {% if item.description %}\r\n                    <div class=\"product-desc\">{{ item.description }}</div>\r\n                    {% endif %}\r\n                </td>\r\n\r\n                <td class=\"text-right nowrap\">\r\n                    <b>{{ item.qty or 0 }}</b>\r\n                </td>\r\n\r\n                <td class=\"text-right nowrap\">\r\n                    {{ frappe.utils.fmt_money(item.rate or 0, currency=cur) }}\r\n                </td>\r\n\r\n                {% if has_expiry %}\r\n                <td class=\"text-center nowrap\">\r\n                    {% if item.expired_date %}\r\n                    <b>{{ frappe.utils.formatdate(item.expired_date) }}</b>\r\n                    {% else %}-{% endif %}\r\n                </td>\r\n                {% endif %}\r\n\r\n                <td class=\"text-right nowrap\">\r\n                    <b>{{ frappe.utils.fmt_money(item.amount or 0, currency=cur) }}</b>\r\n                </td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Total -->\r\n    <div class=\"total-box\">\r\n        <div class=\"subtotal-row\">\r\n            <span>Total Quantity</span>\r\n            <span>{{ items | sum(attribute=\"qty\") }}</span>\r\n        </div>\r\n\r\n        <div class=\"total-row\">\r\n            <span>GRAND TOTAL</span>\r\n            <span>{{ frappe.utils.fmt_money(doc.get(\"total\") or 0, currency=cur) }}</span>\r\n        </div>\r\n\r\n        <div class=\"words-row\">\r\n            <span>In Words:</span>\r\n            <span>{{ frappe.utils.money_in_words(doc.get(\"total\") or 0, cur) }}</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Notes -->\r\n    {% if doc.get(\"notes\") or doc.get(\"terms\") %}\r\n    <div class=\"notes-section\">\r\n        Notes: <span>{{ doc.get(\"notes\") or doc.get(\"terms\") }}</span>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- Signatures -->\r\n    <div class=\"signature-section\">\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Prepared By Purchase Officer</div>\r\n        </div>\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Checked By Accountant</div>\r\n        </div>\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Verified By Finance</div>\r\n        </div>\r\n         <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Approved By director</div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>",
