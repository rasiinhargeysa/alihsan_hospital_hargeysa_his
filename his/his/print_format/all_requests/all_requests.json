 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <!-- CSS link -->\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n\r\n    <!-- Font Awesome -->\r\n    <link rel=\"stylesheet\"\r\n          href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\">\r\n</head>\r\n\r\n<body style=\"width: 700px; margin: 0 auto;\">\r\n\r\n    {{ letter_head }}\r\n\r\n    <!-- Patient Information -->\r\n    <div style=\"border: 1px solid black; padding: 0 15px; width: 100%;\">\r\n\r\n        <div style=\"display: flex; align-items: center; justify-content: space-between;\">\r\n            <p style=\"flex: 1\" class=\"bold\">\r\n                Patient: {{ doc.patient }}\r\n            </p>\r\n\r\n            <p style=\"flex: 1\" class=\"bold\">\r\n                Patient Name:\r\n                {{ doc.patient_name or frappe.db.get_value(\"Patient\", doc.patient, \"patient_name\") }}\r\n            </p>\r\n        </div>\r\n\r\n        <div style=\"display: flex; align-items: center; justify-content: space-between;\">\r\n            <p style=\"flex: 1\" class=\"bold\">\r\n                {{ _(\"Age: \") }}\r\n                {{ frappe.db.get_value(\"Patient\", doc.patient, \"p_age\") }}\r\n                {{ frappe.db.get_value(\"Patient\", doc.patient, \"age_type\") }}\r\n            </p>\r\n\r\n            <p style=\"flex: 1\" class=\"bold\">\r\n                {{ _(\"Date: \") }} {{ doc.date }}\r\n            </p>\r\n        </div>\r\n\r\n        <div style=\"display: flex; align-items: center; justify-content: space-between;\">\r\n            <p style=\"flex: 1\" class=\"bold\">\r\n                {{ _(\"Doctor: \") }} {{ doc.practitioner }}\r\n            </p>\r\n\r\n            <p style=\"flex: 1\" class=\"bold\">\r\n                {{ _(\"Department: \") }} {{ doc.medical_department or \"\" }}\r\n            </p>\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- VA EXAMINATION -->\r\n    <!-- ====================================================== -->\r\n\r\n    {% set va_exam = frappe.get_all(\r\n        \"VA Examination\",\r\n        filters={\r\n            \"patient\": doc.patient,\r\n            \"date\": doc.date,\r\n             \"docstatus\": [\"!=\", 2]\r\n        },\r\n        fields=[\r\n            \"name\",\r\n            \"date\",\r\n            \"va\",\r\n            \"iop_right\",\r\n            \"va1\",\r\n            \"iop_left\"\r\n        ],\r\n        order_by=\"date desc\",\r\n        limit_page_length=1\r\n    ) %}\r\n\r\n    {% if va_exam %}\r\n\r\n    <section class=\"table_section\">\r\n\r\n        <h3>VA Examination</h3>\r\n\r\n        <table>\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"color:black\"><b>No</b></th>\r\n                    <th style=\"color:black\"><b>RE</b></th>\r\n                    <th style=\"color:black\"><b>LE</b></th>\r\n                    <th style=\"color:black\"><b>IOP RE</b></th>\r\n                    <th style=\"color:black\"><b>IOP LE</b></th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for va in va_exam %}\r\n\r\n                <tr>\r\n                    <td>{{ loop.index }}</td>\r\n\r\n                    <td>\r\n                        {{ va.va or \"\" }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ va.va1 or \"\" }}\r\n                    </td>\r\n                    <td>\r\n                        {{ va.iop_right or \"\" }}\r\n                    </td>\r\n\r\n\r\n                    <td>\r\n                        {{ va.iop_left or \"\" }}\r\n                    </td>\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n        </table>\r\n\r\n    </section>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- LAB TEST PRESCRIPTION -->\r\n    <!-- ====================================================== -->\r\n\r\n    {% if doc.lab_test_prescription %}\r\n\r\n    <section class=\"table_section\">\r\n\r\n        <h3>Laboratory</h3>\r\n\r\n        <table>\r\n\r\n            <thead>\r\n                <tr class=\"bold\">\r\n                    <th style=\"color:black\">\r\n                        <b>No</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Lab Test Name</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Comment</b>\r\n                    </th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for lab in doc.lab_test_prescription %}\r\n\r\n                <tr>\r\n                    <td>{{ lab.idx }}</td>\r\n\r\n                    <td class=\"drug\">\r\n                        {{ lab.lab_test_name }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ lab.lab_test_comment or '' }}\r\n                    </td>\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n\r\n        </table>\r\n\r\n    </section>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- IMAGING / RADIOLOGY -->\r\n    <!-- ====================================================== -->\r\n\r\n    {% if doc.radiology_prescription %}\r\n\r\n    <section class=\"table_section\">\r\n\r\n        <h3>Imaging</h3>\r\n\r\n        <table>\r\n\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"color:black\">\r\n                        <b>No</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Imaging</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Comments</b>\r\n                    </th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for img in doc.radiology_prescription %}\r\n\r\n                <tr>\r\n                    <td>{{ img.idx }}</td>\r\n\r\n                    <td class=\"drug\">\r\n                        {{ img.image }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ img.lab_test_comment or '' }}\r\n                    </td>\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n\r\n        </table>\r\n\r\n    </section>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- PROCEDURE PRESCRIPTION -->\r\n    <!-- ====================================================== -->\r\n\r\n    {% if doc.procedure_prescription %}\r\n\r\n    <section class=\"table_section\">\r\n\r\n        <h3>Procedure</h3>\r\n\r\n        <table>\r\n\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"color:black\">\r\n                        <b>No</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Procedure</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Comment</b>\r\n                    </th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for pro in doc.procedure_prescription %}\r\n\r\n                <tr>\r\n                    <td>{{ pro.idx }}</td>\r\n\r\n                    <td class=\"drug\">\r\n                        {{ pro.procedure }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ pro.lab_test_comment or \"\" }}\r\n                    </td>\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n\r\n        </table>\r\n\r\n    </section>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- OTHER SERVICES -->\r\n    <!-- ====================================================== -->\r\n\r\n    {% if doc.services_prescription %}\r\n\r\n    <section class=\"table_section\">\r\n\r\n        <h3>Other Service</h3>\r\n\r\n        <table>\r\n\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"color:black\">\r\n                        <b>No</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Service</b>\r\n                    </th>\r\n\r\n                    <th style=\"color:black\">\r\n                        <b>Comments</b>\r\n                    </th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n\r\n                {% for img in doc.services_prescription %}\r\n\r\n                <tr>\r\n                    <td>{{ img.idx }}</td>\r\n\r\n                    <td class=\"drug\">\r\n                        {{ img.service }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ img.lab_test_comment or '' }}\r\n                    </td>\r\n                </tr>\r\n\r\n                {% endfor %}\r\n\r\n            </tbody>\r\n\r\n        </table>\r\n\r\n    </section>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- MEDICINE PRESCRIPTION -->\r\n    <!-- ====================================================== -->\r\n\r\n    {% if doc.drug_prescription %}\r\n\r\n    <table class=\"table\"\r\n           style=\"width:100%; border-collapse: collapse; margin-top:10px;\">\r\n\r\n        <h3>Medicine Prescription</h3>\r\n\r\n        <thead>\r\n\r\n            <tr>\r\n\r\n                <th style=\"border-bottom:1px solid black;\r\n                           padding:5px;\r\n                           font-weight:bold;\r\n                           color:black;\">\r\n                    Medication\r\n                </th>\r\n\r\n                <th style=\"border-bottom:1px solid black;\r\n                           padding:5px;\r\n                           font-weight:bold;\r\n                           color:black;\">\r\n                    Quantity\r\n                </th>\r\n\r\n                <th style=\"border-bottom:1px solid black;\r\n                           padding:5px;\r\n                           font-weight:bold;\r\n                           color:black;\">\r\n                    Frequency\r\n                </th>\r\n\r\n                <th style=\"border-bottom:1px solid black;\r\n                           padding:5px;\r\n                           font-weight:bold;\r\n                           color:black;\">\r\n                    Period\r\n                </th>\r\n\r\n                <th style=\"border-bottom:1px solid black;\r\n                           padding:5px;\r\n                           font-weight:bold;\r\n                           color:black;\">\r\n                    Comments\r\n                </th>\r\n\r\n            </tr>\r\n\r\n        </thead>\r\n\r\n        <tbody>\r\n\r\n            {% for drug in doc.drug_prescription %}\r\n\r\n            <tr>\r\n\r\n                <td style=\"border-bottom:1px solid black; padding:5px;\">\r\n                    {{ drug.drug_code }}\r\n                </td>\r\n\r\n                <td style=\"border-bottom:1px solid black; padding:5px;\">\r\n                    {{ drug.qty }}\r\n                </td>\r\n\r\n                <td style=\"border-bottom:1px solid black; padding:5px;\">\r\n                    {{ drug.dosage or \"\" }}\r\n                </td>\r\n\r\n                <td style=\"border-bottom:1px solid black; padding:5px;\">\r\n                    {{ drug.period or \"\" }}\r\n                </td>\r\n\r\n                <td style=\"border-bottom:1px solid black; padding:5px;\">\r\n                    {{ drug.comment or \"\" }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endfor %}\r\n\r\n        </tbody>\r\n\r\n    </table>\r\n\r\n    {% endif %}\r\n\r\n\r\n    <!-- ====================================================== -->\r\n    <!-- SIGNATURE -->\r\n    <!-- ====================================================== -->\r\n\r\n\r\n\r\n</body>\r\n</html>",
