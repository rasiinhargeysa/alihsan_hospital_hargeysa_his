 "html": "<div class=\"omr-print\">\r\n<style>\r\n  .omr-print {\r\n    font-family: 'Georgia', 'Times New Roman', serif;\r\n    color: #1c1c2e;\r\n    font-size: 13px;\r\n    line-height: 1.5;\r\n  }\r\n  .omr-print table { border-collapse: collapse; width: 100%; }\r\n\r\n  /* ---- Header ---- */\r\n  .omr-header td { vertical-align: middle; padding: 0; }\r\n  .omr-logo { height: 72px; }\r\n  .omr-divider {\r\n    width: 2px;\r\n    background: #e2811c;\r\n    height: 56px;\r\n  }\r\n  .omr-tagline {\r\n    font-family: 'Trebuchet MS', 'Comic Sans MS', sans-serif;\r\n    font-weight: 700;\r\n    color: #1a2a6c;\r\n    font-size: 19px;\r\n    line-height: 1.25;\r\n    padding-left: 18px;\r\n  }\r\n\r\n  .omr-bars { margin-top: 14px; }\r\n  .omr-bars td { height: 4px; padding: 0; }\r\n  .omr-bars td:nth-child(1), .omr-bars td:nth-child(3) { background: #1a2a6c; }\r\n  .omr-bars td:nth-child(2), .omr-bars td:nth-child(4) { background: #e2811c; }\r\n  .omr-bars td + td { width: 1%; padding-left: 4px; }\r\n\r\n  /* ---- Title block ---- */\r\n  .omr-title {\r\n    font-family: 'Trebuchet MS', Arial, sans-serif;\r\n    font-weight: 700;\r\n    letter-spacing: 1.5px;\r\n    text-transform: uppercase;\r\n    font-size: 22px;\r\n    color: #16213e;\r\n    margin: 26px 0 2px 0;\r\n  }\r\n  .omr-subline {\r\n    font-family: Arial, sans-serif;\r\n    color: #8a93a6;\r\n    font-size: 11px;\r\n    margin-bottom: 14px;\r\n  }\r\n  .omr-rule {\r\n    border: none;\r\n    border-top: 2px solid #1a2a6c;\r\n    margin: 0 0 18px 0;\r\n  }\r\n\r\n  /* ---- Meta panel ---- */\r\n  .omr-meta {\r\n    background: #f7f8fb;\r\n    border: 1px solid #e3e6ee;\r\n    border-radius: 4px;\r\n    padding: 14px 18px;\r\n    margin-bottom: 22px;\r\n  }\r\n  .omr-meta table td { padding: 4px 8px; vertical-align: top; }\r\n  .omr-meta-label {\r\n    font-family: Arial, sans-serif;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.5px;\r\n    font-size: 10px;\r\n    color: #1a2a6c;\r\n    font-weight: 700;\r\n  }\r\n  .omr-meta-value {\r\n    font-size: 14px;\r\n    color: #1c1c2e;\r\n    padding-top: 1px;\r\n  }\r\n\r\n  /* ---- Items section (Text Editor field content) ---- */\r\n  .omr-items-label {\r\n    font-family: Arial, sans-serif;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.5px;\r\n    font-size: 10.5px;\r\n    color: #ffffff;\r\n    background: #1a2a6c;\r\n    text-align: left;\r\n    padding: 9px 12px;\r\n    margin-bottom: 0;\r\n  }\r\n  .omr-items {\r\n    margin-bottom: 30px;\r\n  }\r\n  /* Style whatever table structure the Text Editor field injects */\r\n  .omr-items table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n  .omr-items table th {\r\n    font-family: Arial, sans-serif;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.5px;\r\n    font-size: 10.5px;\r\n    color: #ffffff;\r\n    background: #1a2a6c;\r\n    text-align: left;\r\n    padding: 8px 12px;\r\n  }\r\n  .omr-items table td {\r\n    padding: 8px 12px;\r\n    border-bottom: 1px solid #e3e6ee;\r\n    font-size: 13.5px;\r\n  }\r\n  .omr-items table tr:nth-child(even) td { background: #fafbfd; }\r\n  /* Repeat header row on each printed page, keep rows intact */\r\n  .omr-items table thead { display: table-header-group; }\r\n  .omr-items table tr { page-break-inside: avoid; }\r\n\r\n  /* ---- Signatures ---- */\r\n  .omr-sign { margin-top: 56px; }\r\n  .omr-sign td {\r\n    text-align: center;\r\n    padding-top: 30px;\r\n    border-top: 1px solid #1c1c2e;\r\n    font-family: Arial, sans-serif;\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    color: #1a2a6c;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.5px;\r\n  }\r\n  .omr-sign-spacer { width: 24px; border: none !important; }\r\n\r\n  /* ---- Footer ---- */\r\n  .omr-footer {\r\n    margin-top: 40px;\r\n    padding-top: 10px;\r\n    border-top: 1px solid #e3e6ee;\r\n    font-family: Arial, sans-serif;\r\n    font-size: 9.5px;\r\n    color: #a7adba;\r\n    text-align: center;\r\n    letter-spacing: 0.3px;\r\n  }\r\n</style>\r\n\r\n  <!-- Header -->\r\n  <table class=\"omr-header\">\r\n    <tr>\r\n      <td style=\"width: 1%; white-space: nowrap;\">\r\n      {{ letter_head }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <table class=\"omr-bars\"><tr><td></td><td></td><td></td><td></td></tr></table>\r\n\r\n  <!-- Title -->\r\n  <div class=\"omr-title\">Material Request</div>\r\n  <div class=\"omr-subline\">Request No. {{ doc.name }}</div>\r\n   <div class=\"omr-subline\">User. {{ doc.user or doc.owner  }}</div>\r\n  <hr class=\"omr-rule\">\r\n\r\n  <!-- Meta -->\r\n  <div class=\"omr-meta\">\r\n    <table>\r\n      <tr>\r\n       \r\n        <td style=\"width: 33%;\">\r\n          <div class=\"omr-meta-label\">Requested By</div>\r\n          <div class=\"omr-meta-value\">{{ doc.full_name }}</div>\r\n            <div class=\"omr-meta-value\">Signature:____________</div>\r\n        </td>\r\n        \r\n          <td style=\"width: 33%;\">\r\n          <div class=\"omr-meta-label\">Date</div>\r\n          <div class=\"omr-meta-value\">{{ frappe.utils.formatdate(doc.date) }}</div>\r\n        </td>\r\n        <td style=\"width: 33%;\">\r\n          <div class=\"omr-meta-label\">Department</div>\r\n          <div class=\"omr-meta-value\">{{ doc.department or \"\" }}</div>\r\n        </td>\r\n          <td style=\"width: 33%;\">\r\n          <div class=\"omr-meta-label\">Signature</div>\r\n          <div class=\"omr-meta-value\">_____________</div>\r\n        </td>\r\n      </tr>\r\n    </table>\r\n  </div>\r\n\r\n  <!-- Items -->\r\n  <div class=\"omr-items-label\">Item Requested</div>\r\n  <div class=\"omr-items\">\r\n    {{ doc.request }}\r\n  </div>\r\n\r\n  <!-- Signatures -->\r\n  <table class=\"omr-sign\">\r\n    <tr>\r\n      <td>Verified By</td>\r\n      <td class=\"omr-sign-spacer\"></td>\r\n      <td>Checked By</td>\r\n      <td class=\"omr-sign-spacer\"></td>\r\n      <td>Approved By</td>\r\n      <td class=\"omr-sign-spacer\"></td>\r\n      <td>Approved By</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <div class=\"omr-footer\">\r\n    Isbitaalka Takhasusiga Al Ihsan &mdash; Al Ihsan Specialist Hospital &nbsp;|&nbsp; We Care Before We Cure\r\n  </div>\r\n\r\n</div>",
