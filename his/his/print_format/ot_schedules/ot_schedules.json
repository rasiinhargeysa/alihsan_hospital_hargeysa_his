 "font_size": 14,
 "html": "<!--\n============================================================\n PRINT FORMAT: OT Schedule (Operation Theatre Schedule)\n Module: HIS  |  Type: Jinja (Custom HTML)\n Brand: Al Ihsan Specialist Hospital (ink-saving monochrome)\n============================================================\n-->\n\n<style>\n    @page {\n        size: A4;\n        margin: 8mm 10mm;\n    }\n\n    .print-format {\n        font-family: Arial, sans-serif;\n        font-size: 11.5px;\n        color: #000;\n        padding: 4px;\n    }\n\n    .print-format .section,\n    .print-format .patient-box,\n    .print-format .pair-row {\n        page-break-inside: avoid;\n    }\n\n    /* ---------- Header / title ---------- */\n    .print-format .report-title {\n        text-align: center;\n        font-size: 20px;\n        font-weight: 800;\n        color: #444;\n        letter-spacing: 3px;\n        margin-top: 10px;\n        margin-bottom: 4px;\n        text-transform: uppercase;\n    }\n\n    .print-format .report-title-underline {\n        width: 160px;\n        height: 1px;\n        background-color: #777;\n        margin: 0 auto 14px;\n    }\n\n    .print-format .doc-name {\n        text-align: center;\n        font-size: 11px;\n        color: #000;\n        margin-bottom: 10px;\n    }\n\n    .print-format .status-wrap { text-align: center; margin-bottom: 16px; }\n\n    .print-format .status-pill {\n        border: 1px solid #bbb;\n        display: inline-block;\n        padding: 4px 16px;\n        border-radius: 12px;\n        font-size: 11px;\n        font-weight: bold;\n        letter-spacing: 0.5px;\n        text-transform: uppercase;\n        background: #fff;\n        color: #000;\n    }\n\n    /* ---------- Patient info card ---------- */\n    .print-format .patient-box {\n        border: 1px solid #bbb;\n        border-radius: 8px;\n        padding: 9px 16px !important;\n        margin-bottom: 12px;\n        background-color: #fff;\n    }\n\n    .print-format .patient-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .print-format .patient-table td {\n        border: none;\n        vertical-align: top;\n        font-size: 11.5px;\n        font-weight: bold;\n        color: #000;\n        padding: 1px 0 !important;\n        line-height: 1.5;\n    }\n\n    /* ---------- Section card (header + body, always full width) ---------- */\n    .print-format .section {\n        margin-bottom: 10px;\n        border-radius: 8px;\n        overflow: hidden;\n        border: 1px solid #bbb;\n        box-shadow: none;\n    }\n\n    .print-format .section-title {\n        border-bottom: 1px solid #bbb;\n        background: #f2f2f2;\n        color: black;\n        padding: 6px 14px !important;\n        font-weight: bold;\n        letter-spacing: 0.5px;\n        font-size: 13px;\n    }\n\n    .print-format .field-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .print-format .field-table td {\n        padding: 5px 14px !important;\n        font-size: 11.5px;\n        border-bottom: 1px solid #bbb;\n    }\n\n    .print-format .field-table tr:last-child td {\n        border-bottom: none;\n    }\n\n    .print-format .field-table td.field-label {\n        font-weight: bold;\n        color: #000;\n        width: 42%;\n        background: #fff;\n        border-right: 1px solid #bbb;\n    }\n\n    .print-format .field-table td.field-value {\n        color: #000;\n    }\n\n    /* ---------- Two mini-sections side by side (for VA / IOP pairing) ---------- */\n    .print-format .pair-row {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 2px;\n    }\n\n    .print-format .pair-row > tbody > tr > td {\n        width: 50%;\n        vertical-align: top;\n        padding: 0;\n    }\n\n    .print-format .pair-row > tbody > tr > td.pair-left {\n        padding-right: 7px;\n    }\n\n    .print-format .pair-row > tbody > tr > td.pair-right {\n        padding-left: 7px;\n    }\n\n    /* ---------- Itemized table (white header / black text) ---------- */\n    .print-format .items-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .print-format .items-table thead th {\n        background: #f2f2f2;\n        color: #444;\n        text-align: left;\n        padding: 8px 14px;\n        font-size: 10.5px;\n        font-weight: bold;\n        letter-spacing: 0.4px;\n        text-transform: uppercase;\n        border-bottom: 1px solid #bbb;\n    }\n\n    .print-format .items-table thead th.num { text-align: right; }\n\n    .print-format .items-table tbody td {\n        padding: 7px 14px;\n        font-size: 11.5px;\n        border-bottom: 1px solid #bbb;\n        color: #000;\n    }\n\n    .print-format .items-table tbody tr:nth-child(even) td {\n        background: #fff;\n    }\n\n    .print-format .items-table tbody tr:last-child td {\n        border-bottom: none;\n    }\n\n    .print-format .items-table td.sn { color: #000; font-weight: bold; }\n    .print-format .items-table td.product { font-weight: bold; color: #000; }\n    .print-format .items-table td.num { text-align: right; }\n\n    /* ---------- Yes / No values ---------- */\n    .print-format .yn-value { font-weight: bold; }\n    .print-format .yn-yes { color: #000; }\n    .print-format .yn-no  { color: #000; }\n\n    /* ---------- Remarks box ---------- */\n    .print-format .remarks-box {\n        padding: 10px 14px !important;\n        font-size: 12px;\n        color: #000;\n        min-height: 40px;\n        line-height: 1.6;\n        background: #fff;\n    }\n\n    .print-format .remarks-box p {\n        margin: 0 0 4px 0 !important;\n    }\n\n    /* ---------- Footer ---------- */\n    .print-format .print-footer {\n        margin-top: 10px;\n        padding-top: 8px;\n        border-top: 1px solid #bbb;\n        font-size: 9.5px;\n        color: #000;\n        text-align: center;\n    }\n</style>\n\n<main style=\"width: 700px; margin: 0 auto;\">\n<div class=\"print-format\">\n\n    {{ letter_head }}\n\n\n    <!-- PATIENT / SURGERY INFO -->\n    <div class=\"patient-box\">\n        <table class=\"patient-table\">\n            <tr>\n                <td width=\"50%\">\n                    Patient ID : {{ doc.patient or \"\" }}<br>\n                    Patient Name : {{ doc.patient_name or \"\" }}<br>\n                    Sex : {{ doc.sex or \"\" }}<br>\n                    Mobile : {{ doc.mobile or \"\" }}\n                </td>\n                <td width=\"50%\">\n                    Schedule Date : {{ frappe.utils.formatdate(doc.date, \"dd-MM-yyyy\") if doc.date else \"\" }}<br>\n                    Doctor : {{ doc.doctor or \"\" }}<br>\n                    Ot Schedule : {{ doc.name or \"\" }}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- SURGERY DETAILS -->\n    <div class=\"section\">\n        <div class=\"section-title\">Surgery Details</div>\n        <table class=\"field-table\">\n            <tr>\n                <td class=\"field-label\">Eye Side</td>\n                <td class=\"field-value\">{{ doc.eye_side or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"field-label\">Surgery Type</td>\n                <td class=\"field-value\">{{ doc.procedure_name or \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- LAB RESULTS -->\n    <div class=\"section\">\n\n        {% if doc.get(\"lab_result_child\") %}\n        <table class=\"items-table\">\n            <thead>\n                <tr>\n                    <th class=\"num\" style=\"width:10%;\">Sr</th>\n                    <th style=\"width:40%;\">Test</th>\n                    <th class=\"num\" style=\"width:25%;\">Result</th>\n                    <th class=\"num\" style=\"width:25%;\">Normal Range</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.lab_result_child %}\n                <tr>\n                    <td class=\"sn num\">{{ loop.index }}</td>\n                    <td class=\"product\">{{ row.test_name or row.test or \"\" }}</td>\n                    <td class=\"num\">{{ row.result or \"\" }}</td>\n                    <td class=\"num\">{{ row.normal_range or \"\" }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n        {% endif %}\n    </div>\n\n    <!-- VA + IOP SIDE BY SIDE -->\n    <table class=\"pair-row\">\n        <tr>\n            <td class=\"pair-left\">\n                <div class=\"section\">\n                    <div class=\"section-title\">VA Examination</div>\n                    <table class=\"field-table\">\n                        <tr>\n                            <td class=\"field-label\">RE VA</td>\n                            <td class=\"field-value\">{{ doc.re_va or \"\" }}</td>\n                        </tr>\n                        <tr>\n                            <td class=\"field-label\">LE VA</td>\n                            <td class=\"field-value\">{{ doc.le_va or \"\" }}</td>\n                        </tr>\n                    </table>\n                </div>\n            </td>\n            <td class=\"pair-right\">\n                <div class=\"section\">\n                    <div class=\"section-title\">IOP Examination</div>\n                    <table class=\"field-table\">\n                        <tr>\n                            <td class=\"field-label\">RE IOP</td>\n                            <td class=\"field-value\">{{ doc.re_iop or \"\" }}</td>\n                        </tr>\n                        <tr>\n                            <td class=\"field-label\">LE IOP</td>\n                            <td class=\"field-value\">{{ doc.le_iop or \"\" }}</td>\n                        </tr>\n                    </table>\n                </div>\n            </td>\n        </tr>\n    </table>\n\n\n    <!-- IOL CALCULATION -->\n    <div class=\"section\">\n        <div class=\"section-title\">IOL Calculation</div>\n        <table class=\"field-table\">\n            <tr>\n                <td class=\"field-label\">RE IOL</td>\n                <td class=\"field-value\">{{ doc.re_iol or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"field-label\">LE IOL</td>\n                <td class=\"field-value\">{{ doc.le_iol or \"\" }}</td>\n            </tr>\n            <tr>\n                <td class=\"field-label\">Consent Form Signed</td>\n                <td class=\"field-value\">\n                    {% if doc.consent_form_signed %}\n                        <span class=\"yn-value yn-yes\">Yes</span>\n                    {% else %}\n                        <span class=\"yn-value yn-no\">No</span>\n                    {% endif %}\n                </td>\n            </tr>\n            <tr>\n                <td class=\"field-label\">Fit For Surgery</td>\n                <td class=\"field-value\">\n                    {% if doc.fit_for_surgery %}\n                        <span class=\"yn-value yn-yes\">Yes</span>\n                    {% else %}\n                        <span class=\"yn-value yn-no\">No</span>\n                    {% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- CHARGES -->\n    <div class=\"section\">\n        <div class=\"section-title\">Charges</div>\n        <table class=\"field-table\">\n            <tr>\n                <td class=\"field-label\">Amount</td>\n                <td class=\"field-value\">{{ frappe.utils.fmt_money(doc.amount, currency=doc.get(\"currency\") or \"USD\") if doc.amount is defined else \"\" }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- REMARKS -->\n    <div class=\"section\">\n        <div class=\"section-title\">Remarks</div>\n        <div class=\"remarks-box\">\n            {{ doc.remarks or \"\" }}\n        </div>\n    </div>\n\n    <!-- FOOTER -->\n    <div class=\"print-footer\">\n        Printed On : {{ frappe.utils.now_datetime().strftime(\"%d-%m-%Y %H:%M:%S\") }}\n        &nbsp;&nbsp;|&nbsp;&nbsp;\n        Printed By : {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") }}\n    </div>\n\n</div>\n</main>",
