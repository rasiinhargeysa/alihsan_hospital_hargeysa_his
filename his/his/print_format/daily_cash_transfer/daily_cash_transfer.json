 "font_size": 14,
 "html": "<style>\r\n    * {\r\n        box-sizing: border-box;\r\n        margin: 0;\r\n        padding: 0;\r\n        font-family: Arial, Helvetica, sans-serif;\r\n    }\r\n\r\n    body {\r\n        font-size: 12px;\r\n        color: #000;\r\n        background: #fff;\r\n    }\r\n\r\n    .print-wrapper {\r\n        width: 100%;\r\n        padding: 8px 18px;\r\n    }\r\n\r\n    /* \u2500\u2500 BRAND HEADER \u2500\u2500 */\r\n    .brand-header {\r\n        text-align: center;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    /* \u2500\u2500 DIVIDER BARS \u2500\u2500 */\r\n    .header-divider {\r\n        display: flex;\r\n        height: 4px;\r\n        margin-bottom: 16px;\r\n        gap: 3px;\r\n    }\r\n    .bar-navy    { background: #10194f; flex: 5; border-radius: 1px; }\r\n    .bar-orange  { background: #e36c12; flex: 1; border-radius: 1px; }\r\n    .bar-navy2   { background: #10194f; flex: 1; border-radius: 1px; }\r\n    .bar-orange2 { background: #e36c12; flex: 3; border-radius: 1px; }\r\n\r\n    /* \u2500\u2500 DOCUMENT TITLE \u2500\u2500 */\r\n    .doc-title {\r\n        text-align: center;\r\n        color: #10194f;\r\n        font-size: 20px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 4px;\r\n        margin-bottom: 4px;\r\n    }\r\n\r\n    .title-orange-line {\r\n        width: 120px;\r\n        height: 3px;\r\n        background: #e36c12;\r\n        margin: 0 auto 14px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    /* \u2500\u2500 DOC NAME \u2500\u2500 */\r\n    .doc-name {\r\n        font-size: 11px;\r\n        color: #777;\r\n        margin-bottom: 14px;\r\n        padding-bottom: 8px;\r\n        border-bottom: 1px solid #dde3ee;\r\n        text-align: center;\r\n    }\r\n\r\n    /* \u2500\u2500 META INFO CARD \u2500\u2500 */\r\n    .meta-card {\r\n        border: 2px solid #10194f;\r\n        border-top: 4px solid #e36c12;\r\n        border-radius: 9px;\r\n        background: #f7f8fb;\r\n        padding: 12px 16px;\r\n        margin-bottom: 16px;\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 0 30px;\r\n    }\r\n\r\n    .detail-row {\r\n        display: flex;\r\n        align-items: baseline;\r\n        padding: 6px 0;\r\n        border-bottom: 1px solid #dde3ee;\r\n        gap: 8px;\r\n    }\r\n\r\n    .detail-row:last-child {\r\n        border-bottom: none;\r\n    }\r\n\r\n    .detail-label {\r\n        min-width: 100px;\r\n        flex-shrink: 0;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        color: #10194f;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .detail-value {\r\n        font-size: 11.5px;\r\n        color: #000;\r\n    }\r\n\r\n    /* \u2500\u2500 DUAL TABLES WRAPPER \u2500\u2500 */\r\n    .dual-tables {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 14px;\r\n        margin-bottom: 16px;\r\n    }\r\n\r\n    .table-section-label {\r\n        background: #10194f;\r\n        color: #fff;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n        padding: 5px 10px;\r\n        border-radius: 4px 4px 0 0;\r\n    }\r\n\r\n    .items-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 10.5px;\r\n    }\r\n\r\n    .items-table thead tr {\r\n        background-color: #10194f;\r\n    }\r\n\r\n    .items-table thead th {\r\n        padding: 7px 8px;\r\n        font-size: 9.5px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.3px;\r\n        border: 1px solid #fff;\r\n        text-align: center;\r\n        color: #fff !important;\r\n    }\r\n\r\n    .items-table thead th.left { text-align: left; }\r\n\r\n    .items-table tbody tr:nth-child(even) { background: #f7f8fb; }\r\n    .items-table tbody tr:nth-child(odd)  { background: #fff; }\r\n\r\n    .items-table tbody td {\r\n        padding: 7px 8px;\r\n        border: 1px solid #bbc5d8;\r\n        text-align: center;\r\n        color: #000;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .items-table tbody td.left { text-align: left; font-weight: bold; }\r\n\r\n    /* \u2500\u2500 TOTALS ROW \u2500\u2500 */\r\n    .totals-bar {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 14px;\r\n        margin-bottom: 16px;\r\n    }\r\n\r\n    .total-box {\r\n        border: 1.5px solid #10194f;\r\n        border-radius: 6px;\r\n        overflow: hidden;\r\n    }\r\n\r\n    .total-box-inner {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n        background: #10194f;\r\n        padding: 8px 14px;\r\n        border-top: 3px solid #e36c12;\r\n    }\r\n\r\n    .total-box-inner .tlabel {\r\n        color: #fff;\r\n        font-size: 10.5px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .total-box-inner .tvalue {\r\n        color: #e36c12;\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    /* \u2500\u2500 REMARK CARD \u2500\u2500 */\r\n    .remark-card {\r\n        border: 1.5px solid #10194f;\r\n        border-radius: 6px;\r\n        overflow: hidden;\r\n        margin-bottom: 24px;\r\n    }\r\n\r\n    .remark-header {\r\n        background: #10194f;\r\n        color: #fff;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        letter-spacing: 0.5px;\r\n        text-transform: uppercase;\r\n        padding: 6px 14px;\r\n    }\r\n\r\n    .remark-body {\r\n        background: #f7f8fb;\r\n        border-top: 3px solid #e36c12;\r\n        padding: 10px 14px;\r\n        font-size: 12px;\r\n        color: #000;\r\n        font-weight: bold;\r\n        line-height: 1.6;\r\n    }\r\n\r\n    /* \u2500\u2500 SIGNATURES \u2500\u2500 */\r\n    .signature-section {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 44px;\r\n        gap: 16px;\r\n    }\r\n\r\n    .signature-box {\r\n        flex: 1;\r\n        text-align: center;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1.5px solid #10194f;\r\n        padding-top: 6px;\r\n        font-size: 10.5px;\r\n        font-weight: bold;\r\n        color: #10194f;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n        margin-top: 40px;\r\n    }\r\n\r\n    @media print {\r\n        .print-wrapper { padding: 5px 14px; }\r\n        .items-table thead tr,\r\n        .total-box-inner,\r\n        .remark-header,\r\n        .table-section-label {\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n    }\r\n</style>\r\n\r\n<div class=\"print-wrapper\">\r\n\r\n    <!-- \u2500\u2500 LETTERHEAD \u2500\u2500 -->\r\n    <div class=\"brand-header\">\r\n        {% if letter_head and not no_letterhead %}\r\n        {{ letter_head }}\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 DIVIDER BARS \u2500\u2500 -->\r\n    <!--<div class=\"header-divider\">-->\r\n    <!--    <div class=\"bar-navy\"></div>-->\r\n    <!--    <div class=\"bar-orange\"></div>-->\r\n    <!--    <div class=\"bar-navy2\"></div>-->\r\n    <!--    <div class=\"bar-orange2\"></div>-->\r\n    <!--</div>-->\r\n\r\n    <!-- \u2500\u2500 TITLE \u2500\u2500 -->\r\n    <div class=\"doc-title\">Daily Cash Transfer</div>\r\n    <div class=\"title-orange-line\"></div>\r\n\r\n    <!-- \u2500\u2500 DOC NAME \u2500\u2500 -->\r\n    <div class=\"doc-name\">{{ doc.name }}</div>\r\n\r\n    <!-- \u2500\u2500 META CARD \u2500\u2500 -->\r\n    <div class=\"meta-card\">\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">User</div>\r\n            <div class=\"detail-value\">{{ doc.owner }}</div>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Date</div>\r\n            <div class=\"detail-value\">{{ frappe.format(doc.date, {'fieldtype': 'Date'}) }}</div>\r\n        </div>\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Username</div>\r\n            <div class=\"detail-value\">{{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 DUAL TABLES \u2500\u2500 -->\r\n    <div class=\"dual-tables\">\r\n\r\n        <!-- CREDIT TABLE -->\r\n        <div>\r\n            <div class=\"table-section-label\">From Accounts</div>\r\n            <table class=\"items-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th style=\"width:30px;\">Sr</th>\r\n                        <th class=\"left\">Account</th>\r\n                   \r\n                        <th>Amount</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for row in doc.from_account %}\r\n                    <tr>\r\n                        <td>{{ loop.index }}</td>\r\n                        <td class=\"left\">{{ row.account }}</td>\r\n                    \r\n                        <td><b>$ {{ \"%.2f\"|format(row.amount or 0) }}</b></td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n\r\n        <!-- DEBIT TABLE -->\r\n        <div>\r\n            <div class=\"table-section-label\">To Accounts</div>\r\n            <table class=\"items-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th style=\"width:30px;\">Sr</th>\r\n                        <th class=\"left\">Account</th>\r\n                       \r\n                        <th>Amount</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for row in doc.to_account %}\r\n                    <tr>\r\n                        <td>{{ loop.index }}</td>\r\n                        <td class=\"left\">{{ row.account }}</td>\r\n                   \r\n                        <td><b>$ {{ \"%.2f\"|format(row.amount or 0) }}</b></td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 TOTALS BAR \u2500\u2500 -->\r\n    <div class=\"totals-bar\">\r\n        <div class=\"total-box\">\r\n            <div class=\"total-box-inner\">\r\n                <span class=\"tlabel\">Total Credit</span>\r\n                <span class=\"tvalue\">$ {{ \"%.2f\"|format(doc.total_credit or 0) }}</span>\r\n            </div>\r\n        </div>\r\n        <div class=\"total-box\">\r\n            <div class=\"total-box-inner\">\r\n                <span class=\"tlabel\">Total Debit</span>\r\n                <span class=\"tvalue\">$ {{ \"%.2f\"|format(doc.total_debit or 0) }}</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 REMARK \u2500\u2500 -->\r\n    {% if doc.remark or doc.remarks %}\r\n    <div class=\"remark-card\">\r\n        <div class=\"remark-header\">Remark</div>\r\n        <div class=\"remark-body\">{{ doc.remark or doc.remarks }}</div>\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- \u2500\u2500 SIGNATURES \u2500\u2500 -->\r\n    <div class=\"signature-section\">\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Prepared By Chief Cashier</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Verified By Accountant</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Approved By Finance Officer</div>\r\n        </div>\r\n    </div>\r\n\r\n</div>",
