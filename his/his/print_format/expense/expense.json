 "font_size": 14,
 "html": "<style>\r\n    * {\r\n        box-sizing: border-box;\r\n        margin: 0;\r\n        padding: 0;\r\n        font-family: Arial, Helvetica, sans-serif;\r\n    }\r\n\r\n    body {\r\n        font-size: 12px;\r\n        color: #000;\r\n        background: #fff;\r\n    }\r\n\r\n    .print-wrapper {\r\n        width: 100%;\r\n        padding: 8px 18px;\r\n    }\r\n\r\n    /* \u2500\u2500 BRAND HEADER \u2500\u2500 */\r\n    .brand-header {\r\n        text-align: center;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    /* \u2500\u2500 DIVIDER BARS \u2500\u2500 */\r\n    .header-divider {\r\n        display: flex;\r\n        height: 4px;\r\n        margin-bottom: 16px;\r\n        gap: 3px;\r\n    }\r\n    .bar-navy    { background: #10194f; flex: 5; border-radius: 1px; }\r\n    .bar-orange  { background: #e36c12; flex: 1; border-radius: 1px; }\r\n    .bar-navy2   { background: #10194f; flex: 1; border-radius: 1px; }\r\n    .bar-orange2 { background: #e36c12; flex: 3; border-radius: 1px; }\r\n\r\n    /* \u2500\u2500 DOCUMENT TITLE \u2500\u2500 */\r\n    .doc-title {\r\n        text-align: center;\r\n        color: #10194f;\r\n        font-size: 20px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 4px;\r\n        margin-bottom: 4px;\r\n    }\r\n\r\n    .title-orange-line {\r\n        width: 100px;\r\n        height: 3px;\r\n        background: #e36c12;\r\n        margin: 0 auto 14px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    /* \u2500\u2500 STATUS BADGE \u2500\u2500 */\r\n    .status-badge {\r\n        text-align: center;\r\n        margin-bottom: 18px;\r\n    }\r\n\r\n    .status-badge span {\r\n        display: inline-block;\r\n        padding: 3px 22px;\r\n        border: 1.5px solid #10194f;\r\n        color: #10194f;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        letter-spacing: 0.14em;\r\n        text-transform: uppercase;\r\n        border-radius: 2px;\r\n    }\r\n\r\n    /* \u2500\u2500 DOC NAME SUB-HEADER \u2500\u2500 */\r\n    .doc-name {\r\n        font-size: 11px;\r\n        color: #777;\r\n        margin-bottom: 14px;\r\n        padding-bottom: 8px;\r\n        border-bottom: 1px solid #dde3ee;\r\n    }\r\n\r\n    /* \u2500\u2500 DETAILS CARD \u2500\u2500 */\r\n    .details-card {\r\n        border: 2px solid #10194f;\r\n        border-top: 4px solid #e36c12;\r\n        border-radius: 9px;\r\n        background: #f7f8fb;\r\n        padding: 14px 18px;\r\n        margin-bottom: 20px;\r\n    }\r\n\r\n    .detail-row {\r\n        display: flex;\r\n        align-items: baseline;\r\n        padding: 7px 0;\r\n        border-bottom: 1px solid #dde3ee;\r\n    }\r\n\r\n    .detail-row:last-child {\r\n        border-bottom: none;\r\n        padding-bottom: 0;\r\n    }\r\n\r\n    .detail-label {\r\n        width: 160px;\r\n        flex-shrink: 0;\r\n        font-size: 10.5px;\r\n        font-weight: bold;\r\n        color: #10194f;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .detail-value {\r\n        font-size: 11.5px;\r\n        color: #000;\r\n        flex: 1;\r\n    }\r\n\r\n    /* Amount gets special treatment */\r\n    .detail-value.amount {\r\n        text-align: right;\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n        color: #10194f;\r\n    }\r\n\r\n    /* \u2500\u2500 AMOUNT HIGHLIGHT BOX \u2500\u2500 */\r\n    .amount-box {\r\n        display: flex;\r\n        justify-content: flex-end;\r\n        margin-bottom: 24px;\r\n    }\r\n\r\n    .amount-inner {\r\n        border: 1.5px solid #10194f;\r\n        border-radius: 6px;\r\n        overflow: hidden;\r\n        min-width: 220px;\r\n    }\r\n\r\n    .amount-label-row {\r\n        background: #10194f;\r\n        color: #fff;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        letter-spacing: 0.5px;\r\n        text-transform: uppercase;\r\n        padding: 5px 14px;\r\n        text-align: center;\r\n    }\r\n\r\n    .amount-value-row {\r\n        background: #f7f8fb;\r\n        padding: 8px 14px;\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        color: #10194f;\r\n        text-align: right;\r\n        border-top: 3px solid #e36c12;\r\n    }\r\n\r\n    /* \u2500\u2500 SIGNATURES \u2500\u2500 */\r\n    .signature-section {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 40px;\r\n        gap: 16px;\r\n    }\r\n\r\n    .signature-box {\r\n        flex: 1;\r\n        text-align: center;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1.5px solid #10194f;\r\n        padding-top: 6px;\r\n        font-size: 10.5px;\r\n        font-weight: bold;\r\n        color: #10194f;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n        margin-top: 40px;\r\n    }\r\n\r\n    @media print {\r\n        .print-wrapper { padding: 5px 14px; }\r\n        .details-card,\r\n        .amount-label-row {\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n    }\r\n</style>\r\n\r\n<div class=\"print-wrapper\">\r\n\r\n    <!-- \u2500\u2500 LETTERHEAD \u2500\u2500 -->\r\n    <div class=\"brand-header\">\r\n        {% if letter_head and not no_letterhead %}\r\n        {{ letter_head }}\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 DIVIDER BARS \u2500\u2500 -->\r\n\r\n\r\n    <!-- \u2500\u2500 TITLE \u2500\u2500 -->\r\n    <div class=\"doc-title\">Expenses</div>\r\n    <div class=\"title-orange-line\"></div>\r\n\r\n    <!-- \u2500\u2500 STATUS \u2500\u2500 -->\r\n    <div class=\"status-badge\">\r\n        <span>{{ doc.docstatus == 0 and \"DRAFT\" or doc.docstatus == 1 and \"PAID\" or \"CANCELLED\" }}</span>\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 DOC NAME \u2500\u2500 -->\r\n    <div class=\"doc-name\">{{ doc.name }}</div>\r\n\r\n    <!-- \u2500\u2500 DETAILS CARD \u2500\u2500 -->\r\n    <div class=\"details-card\">\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">SN:</div>\r\n            <div class=\"detail-value\">{{ doc.name or \"\" }}</div>\r\n        </div>\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Expense Type:</div>\r\n            <div class=\"detail-value\">{{ doc.expense_type or \"\" }}</div>\r\n        </div>\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Account:</div>\r\n            <div class=\"detail-value\">{{ doc.default_account or doc.account or \"\" }}</div>\r\n        </div>\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Paid From:</div>\r\n            <div class=\"detail-value\">{{ doc.payable_account or doc.paid_from or \"\" }}</div>\r\n        </div>\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Remark:</div>\r\n            <div class=\"detail-value\">{{ doc.remark or doc.description or \"\" }}</div>\r\n        </div>\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Date:</div>\r\n            <div class=\"detail-value\">{{ frappe.format(doc.date, {'fieldtype': 'Date'}) }}</div>\r\n        </div>\r\n\r\n        <div class=\"detail-row\">\r\n            <div class=\"detail-label\">Cost Center:</div>\r\n            <div class=\"detail-value\">{{ doc.cost_center or \"\" }}</div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 AMOUNT HIGHLIGHT \u2500\u2500 -->\r\n    <div class=\"amount-box\">\r\n        <div class=\"amount-inner\">\r\n            <div class=\"amount-label-row\">Total Amount</div>\r\n            <div class=\"amount-value-row\">$ {{ doc.total_sanctioned_amount or doc.grand_total or doc.amount or \"0.00\" }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- \u2500\u2500 SIGNATURES \u2500\u2500 -->\r\n    <div class=\"signature-section\">\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Prepared By Cheif Cashier</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Chceked By Accountant</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Approved By Finance</div>\r\n        </div>\r\n    </div>\r\n\r\n</div>",
 "idx": 0,
