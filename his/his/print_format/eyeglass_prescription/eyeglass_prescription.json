 "font_size": 14,
 "html": "<style>\r\n    /* A5 PORTRAIT print sizing - 148mm wide x 210mm tall */\r\n    @page {\r\n        size: A5 portrait;\r\n        margin: 6mm;\r\n    }\r\n\r\n    @media print {\r\n        html, body {\r\n            width: 148mm;\r\n            height: 210mm;\r\n        }\r\n    }\r\n\r\n    .rx-main {\r\n        font-family: Arial, sans-serif;\r\n        color: #333;\r\n        width: 100%;\r\n        max-width: 136mm;\r\n        margin: 0 auto;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .rx-header {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 20px;\r\n        border-bottom: 2px solid #f5821f;\r\n        padding-bottom: 6px;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    .rx-title {\r\n        text-align: center;\r\n        font-size: 14px;\r\n        font-weight: 800;\r\n        color: #16215c;\r\n        letter-spacing: 1.5px;\r\n        text-decoration: none;\r\n        text-transform: uppercase;\r\n        margin-top: 4px;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .rx-title-underline {\r\n        width: 90px;\r\n        height: 2px;\r\n        background-color: #f5821f;\r\n        margin: 0 auto 8px;\r\n    }\r\n\r\n    .section-title {\r\n        background: #16215c;\r\n        color: #fff;\r\n        border-radius: 4px 4px 0 0;\r\n        padding: 3px 8px;\r\n        font-weight: bold;\r\n        font-size: 9px;\r\n        letter-spacing: 0.3px;\r\n        margin-top: 6px;\r\n    }\r\n\r\n    .patient-box {\r\n        border: 1px solid #16215c;\r\n        border-top: none;\r\n        border-radius: 0 0 5px 5px;\r\n        padding: 5px 8px;\r\n        margin-bottom: 6px;\r\n        background-color: #fbf6ef;\r\n    }\r\n\r\n    .patient-box .field {\r\n        font-size: 9px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        margin-bottom: 3px;\r\n        display: block;\r\n        width: 100%;\r\n    }\r\n\r\n    .patient-box .field span.value {\r\n        font-weight: normal;\r\n        color: #333;\r\n    }\r\n\r\n    .table1 {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 6px;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .table1 th {\r\n        background: #fbf6ef;\r\n        color: #16215c !important;\r\n        border: 1px solid #f5821f;\r\n        padding: 2px;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        word-wrap: break-word;\r\n    }\r\n\r\n    .table1 td {\r\n        border: 1px solid #ccc;\r\n        padding: 2px;\r\n        font-size: 8px;\r\n        text-align: center;\r\n        color: #333;\r\n        word-wrap: break-word;\r\n        background-color: #fff;\r\n    }\r\n\r\n    .eye-heading {\r\n        color: #16215c;\r\n        font-size: 9px;\r\n        font-weight: bold;\r\n        margin-top: 4px;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    .rx-footer-note {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 2px;\r\n        font-size: 8px;\r\n        margin-top: 6px;\r\n        color: #16215c;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .rx-footer-note span.value {\r\n        font-weight: normal;\r\n        color: #333;\r\n    }\r\n\r\n    .rx-bottom-bar {\r\n        margin-top: 8px;\r\n        padding-top: 4px;\r\n        border-top: 2px solid #f5821f;\r\n        text-align: center;\r\n        font-size: 7px;\r\n        color: #16215c;\r\n        font-weight: bold;\r\n    }\r\n</style>\r\n<section style=\"max-width: 148mm; margin: 0 auto; font-family: Arial, sans-serif;\">\r\n<main class=\"rx-main mx\">\r\n    <header class=\"rx-header mx\">\r\n        <div>\r\n           {{ letter_head }}\r\n        </div>\r\n    </header>\r\n\r\n    <div class=\"rx-title\">Eye Glasses Prescription</div>\r\n    <div class=\"rx-title-underline\"></div>\r\n\r\n    <!-- PATIENT INFO -->\r\n    <div class=\"section-title\">Patient Information</div>\r\n    <div class=\"patient-box\">\r\n        <div class=\"field\">PID: <span class=\"value\">{{ doc.patient }}</span></div>\r\n        <div class=\"field\">Date: <span class=\"value\">{{ doc.date }}</span></div>\r\n        <div class=\"field\">Name: <span class=\"value\">{{ doc.patient_name }}</span></div>\r\n    </div>\r\n\r\n    <!-- LENS DETAILS -->\r\n    <div class=\"section-title\">Lens Details</div>\r\n    <table class=\"table1\" style=\"margin-top: 0; border-radius: 0 0 8px 8px; overflow: hidden;\">\r\n        <thead>\r\n            <tr>\r\n                <th>Material</th>\r\n                <th>Lenses advised</th>\r\n                <th>Specification</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td>{{ doc.lenes_material }}</td>\r\n                <!--Lenses advised-->\r\n                <td>\r\n                    {% if doc.distance or doc.near or doc.bifocal or doc.progressive or doc.sunglass or doc.contac_lenses %}\r\n                        {% if doc.distance %}\r\n                            Distance,\r\n                        {% endif %}\r\n                        {% if doc.near %}\r\n                            Near,\r\n                        {% endif %}\r\n                        {% if doc.bifocal %}\r\n                            Bifocal,\r\n                        {% endif %}\r\n                        {% if doc.progressive %}\r\n                            Progressive,\r\n                            <br>\r\n                        {% endif %}\r\n                        {% if doc.sunglass %}\r\n                            Sunglass,\r\n                        {% endif %}\r\n                        {% if doc.contac_lenses %}\r\n                            Contact lenses\r\n                        {% endif %}\r\n                    {% else %}\r\n                        No lenses advised\r\n                    {% endif %}\r\n                </td>\r\n                <!--Lenses advised-->\r\n\r\n                <!--specification-->\r\n                <td>\r\n                    {% if doc.photo_solar or doc.balance or doc.seperate or doc.ar or doc.hc_coating or doc.hmc_coating or doc.polorized_white or doc.white %}\r\n                        {% if doc.photo_solar %}\r\n                            Photo Solar,\r\n                        {% endif %}\r\n                        {% if doc.balance %}\r\n                            Balance,\r\n                        {% endif %}\r\n                        {% if doc.seperate %}\r\n                            Separate,\r\n                        {% endif %}\r\n                        {% if doc.ar %}\r\n                            AR (Blue Cut),\r\n                        {% endif %}\r\n                        {% if doc.hc_coating %}\r\n                            HC Coating,\r\n                            <br>\r\n                        {% endif %}\r\n                        {% if doc.hmc_coating %}\r\n                            HMC Coating,\r\n                        {% endif %}\r\n                        {% if doc.polorized_white %}\r\n                            Polarized White,\r\n                        {% endif %}\r\n                        {% if doc.white %}\r\n                            White\r\n                        {% endif %}\r\n                    {% else %}\r\n                        No specifications\r\n                    {% endif %}\r\n                </td>\r\n                <!--specification-->\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- RIGHT / LEFT EYE -->\r\n    <div class=\"section-title\">Refraction Details</div>\r\n    <div style=\"border: 1px solid #16215c; border-top: none; border-radius: 0 0 5px 5px; padding: 6px 8px; margin-bottom: 6px; background-color: #fff;\">\r\n\r\n        <div style=\"display: flex; flex-direction: column; gap: 4px;\">\r\n\r\n            <!--right-->\r\n            <div style=\"width: 100%\">\r\n                <div class=\"eye-heading\">Right Eye</div>\r\n                <table class=\"table1\" style=\"width: 100%; margin-bottom: 0;\">\r\n                    <thead>\r\n                        <tr>\r\n                            <th>UCVA</th>\r\n                            <th>Sph</th>\r\n                            <th>Cyl</th>\r\n                            <th>Axis</th>\r\n                            <th>ADD</th>\r\n                            <th>PRISM</th>\r\n                            <th>CV/A</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody>\r\n                    {% for d in doc.right_eye %}\r\n                        <tr>\r\n                            <td>{{ d.ucva or \"\" }}</td>\r\n                            <td>{{ d.sph or \"\" }}</td>\r\n                            <td>{{ d.cyl or \"\" }}</td>\r\n                            <td>{{ d.axis or '' }}</td>\r\n                            <td>{{ d.add or '' }}</td>\r\n                            <td>{{ d.prisma or '' }}</td>\r\n                            <td>{{ d.s_va or '' }}</td>\r\n                        </tr>\r\n                    {% endfor %}\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n\r\n            <!--left-->\r\n            <div style=\"width: 100%\">\r\n                <div class=\"eye-heading\">Left Eye</div>\r\n                <table class=\"table1\" style=\"width: 100%; margin-bottom: 0;\">\r\n                    <thead>\r\n                        <tr>\r\n                            <th>UCVA</th>\r\n                            <th>Sph</th>\r\n                            <th>Cyl</th>\r\n                            <th>Axis</th>\r\n                            <th>ADD</th>\r\n                            <th>PRISM</th>\r\n                            <th>CV/A</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody>\r\n                    {% for d in doc.left_eye %}\r\n                        <tr>\r\n                            <td>{{ d.ucva or \"\" }}</td>\r\n                            <td>{{ d.sph or \"\" }}</td>\r\n                            <td>{{ d.cyl or \"\" }}</td>\r\n                            <td>{{ d.axis or '' }}</td>\r\n                            <td>{{ d.add or '' }}</td>\r\n                            <td>{{ d.prisma or '' }}</td>\r\n                            <td>{{ d.s_va or '' }}</td>\r\n                        </tr>\r\n                    {% endfor %}\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ADDITIONAL NOTES -->\r\n    <div class=\"rx-footer-note\">\r\n        <span>Distance P.D: <span class=\"value\">{{ doc.distance_pd or \"\" }}</span></span>\r\n        <span>Near P.D: <span class=\"value\">{{ doc.near_pd or \"\" }}</span></span>\r\n        <span>Note: <span class=\"value\">{{ doc.note or \"\" }}</span></span>\r\n    </div>\r\n\r\n    <div style=\"margin-top: 4px;\">\r\n        <span style=\"color: #16215c; font-size: 8px; font-weight: bold;\">Referred:</span>\r\n        {% if doc.practitioner %}\r\n        <span style=\"color: #333; font-size: 8px;\">{{ doc.practitioner }}</span>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <p style=\"font-size: 8px; color: #16215c; font-weight: bold; margin-top: 4px; margin-bottom: 2px;\">Printed By: <span style=\"color:#333; font-weight: normal;\">{{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") }}</span></p>\r\n    <span style=\"color: #16215c; font-size: 8px; font-weight: bold;\">Signature: </span>\r\n\r\n    <div class=\"rx-bottom-bar\">\r\n        <!--<div>Sales: 512472 &nbsp;/&nbsp; Whatsapp: +252638881880</div>-->\r\n    </div>\r\n\r\n</main>\r\n</section>",
