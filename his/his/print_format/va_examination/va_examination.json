 "font_size": 14,
 "html": "<style>\r\n    .print-format {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 12px;\r\n        color: #333;\r\n        padding: 10px;\r\n    }\r\n\r\n    .print-format .patient-box {\r\n        border: 1px solid #16215c;\r\n        border-radius: 8px;\r\n        padding: 8px 15px !important;\r\n        margin-bottom: 10px;\r\n        background-color: #fbf6ef;\r\n    }\r\n\r\n    .print-format .patient-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .print-format .patient-table td {\r\n        border: none;\r\n        vertical-align: top;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        padding: 0 !important;\r\n    }\r\n\r\n    .print-format .report-title {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        font-weight: 800;\r\n        color: #16215c;\r\n        letter-spacing: 3px;\r\n        margin-top: 10px;\r\n        margin-bottom: 4px;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .print-format .report-title-underline {\r\n        width: 160px;\r\n        height: 3px;\r\n        background-color: #f5821f;\r\n        margin: 0 auto 15px;\r\n    }\r\n\r\n    .print-format .section-title {\r\n        background: #16215c;\r\n        color: #fff;\r\n        border-radius: 6px 6px 0 0;\r\n        padding: 6px 10px !important;\r\n        font-weight: bold;\r\n        margin-top: 12px;\r\n        letter-spacing: 0.5px;\r\n    }\r\n\r\n    .print-format .eye-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 0;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .print-format .eye-table th,\r\n    .print-format .eye-table td {\r\n        border: 1px solid #ccc;\r\n        padding: 3px 8px !important;\r\n        font-size: 12px;\r\n        line-height: 0.8 !important;\r\n    }\r\n\r\n    .print-format .eye-table th {\r\n        background: #fbf6ef;\r\n        text-align: center;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        border-color: #f5821f;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .print-format .eye-table:not(.anterior-table):not(.posterior-table) td:first-child {\r\n        font-weight: bold;\r\n        width: 35%;\r\n        color: #16215c;\r\n    }\r\n\r\n    .print-format .eye-table.anterior-table th,\r\n    .print-format .eye-table.anterior-table td,\r\n    .print-format .eye-table.posterior-table th,\r\n    .print-format .eye-table.posterior-table td {\r\n        line-height: normal !important;\r\n        padding: 6px 8px !important;\r\n    }\r\n\r\n    .print-format .eye-table.anterior-table td:nth-child(2),\r\n    .print-format .eye-table.posterior-table td:nth-child(2) {\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        font-size: 10px;\r\n        text-align: center;\r\n    }\r\n\r\n    .print-format .fundus-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .print-format .fundus-table th {\r\n        border: 1px solid #f5821f;\r\n        background: #fbf6ef;\r\n        text-align: center;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        font-size: 12px;\r\n        padding: 3px 8px;\r\n        width: 50%;\r\n    }\r\n\r\n    .print-format .fundus-table td {\r\n        border: 1px solid #ccc;\r\n        text-align: center;\r\n        padding: 8px;\r\n    }\r\n\r\n    .print-format .comments-box {\r\n        border: 1px solid #ccc;\r\n        border-top: none;\r\n        min-height: 50px;\r\n        padding: 6px 8px !important;\r\n        margin-top: 0;\r\n        border-radius: 0 0 6px 6px;\r\n        line-height: 0.8 !important;\r\n    }\r\n\r\n    .print-format .comments-box p {\r\n        margin: 0 0 2px 0 !important;\r\n        line-height: 0.8 !important;\r\n    }\r\n\r\n    .print-format .signature-table {\r\n        width: 100%;\r\n        margin-top: 25px;\r\n    }\r\n\r\n    .print-format .signature-table td {\r\n        border: none;\r\n        text-align: center;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        line-height: 0.8 !important;\r\n    }\r\n\r\n    .print-format .signature-line {\r\n        border-bottom: 2px solid #16215c;\r\n        width: 80%;\r\n        margin: 0 auto 8px;\r\n        height: 1px;\r\n    }\r\n</style>\r\n\r\n<main style=\"width: 700px; margin: 0 auto;\">\r\n<div class=\"print-format\">\r\n\r\n    {{ letter_head }}\r\n\r\n    <div class=\"report-title\">Ophthalmology Examination Report</div>\r\n    <div class=\"report-title-underline\"></div>\r\n\r\n    <!-- PATIENT INFO BOX -->\r\n    <div class=\"patient-box\">\r\n        <table class=\"patient-table\">\r\n            <tr>\r\n                <td width=\"50%\">\r\n                    Patient Name : {{ doc.patient_name }}<br>\r\n                    Patient ID : {{ doc.patient }}<br>\r\n                    Sex / Age : {{ doc.sex }} / {{ doc.age }}<br>\r\n                    User : {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") }}<br>\r\n                </td>\r\n                <td width=\"50%\">\r\n                    Lab Ref No : {{ doc.name }}<br>\r\n                    Collected : {{ doc.date }} {{ doc.time or \"\" }}<br>\r\n                    Reported : {{ doc.date }}<br>\r\n                    Printed : {{ frappe.utils.now_datetime() }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- VISUAL ACUITY -->\r\n    <div class=\"section-title\">Visual Acuity Examination</div>\r\n\r\n    <table class=\"eye-table\">\r\n        <thead>\r\n            <tr>\r\n                <th>Examination</th>\r\n                <th>Right Eye</th>\r\n                <th>Left Eye</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td>VA</td>\r\n                <td>{{ doc.va or \"\" }}</td>\r\n                <td>{{ doc.va1 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>PIN HOLE</td>\r\n                <td>{{ doc.pin_hole or \"\" }}</td>\r\n                <td>{{ doc.pin2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>WITH GLASS</td>\r\n                <td>{{ doc.white_glass or \"\" }}</td>\r\n                <td>{{ doc.glass2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>IOP</td>\r\n                <td>{{ doc.iop_right or \"\" }}</td>\r\n                <td>{{ doc.iop_left or \"\" }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ANTERIOR SEGMENT -->\r\n    <div class=\"section-title\">Anterior Segment Examination</div>\r\n\r\n    <table class=\"eye-table anterior-table\">\r\n        <colgroup>\r\n            <col style=\"width: 40%;\">\r\n            <col style=\"width: 20%;\">\r\n            <col style=\"width: 40%;\">\r\n        </colgroup>\r\n        <thead>\r\n            <tr>\r\n                <th>Right Eye</th>\r\n                <th>Examination</th>\r\n                <th>Left Eye</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td>{{ doc.lid or \"\" }}</td>\r\n                <td>LID</td>\r\n                <td>{{ doc.lid2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>{{ doc.conj or \"\" }}</td>\r\n                <td>CONJ</td>\r\n                <td>{{ doc.conj2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>{{ doc.cornea or \"\" }}</td>\r\n                <td>CORNEA</td>\r\n                <td>{{ doc.cornea2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>{{ doc.ac or \"\" }}</td>\r\n                <td>AC</td>\r\n                <td>{{ doc.ac2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>{{ doc.pupil or \"\" }}</td>\r\n                <td>PUPIL</td>\r\n                <td>{{ doc.pupil2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>{{ doc.lens or \"\" }}</td>\r\n                <td>LENS</td>\r\n                <td>{{ doc.lens2 or \"\" }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- POSTERIOR SEGMENT -->\r\n    <!--<div class=\"section-title\">Posterior Segment Examination</div>-->\r\n\r\n    <!--<table class=\"eye-table posterior-table\">-->\r\n    <!--    <colgroup>-->\r\n    <!--        <col style=\"width: 40%;\">-->\r\n    <!--        <col style=\"width: 20%;\">-->\r\n    <!--        <col style=\"width: 40%;\">-->\r\n    <!--    </colgroup>-->\r\n    <!--    <thead>-->\r\n    <!--        <tr>-->\r\n    <!--            <th>Right Eye</th>-->\r\n    <!--            <th>Examination</th>-->\r\n    <!--            <th>Left Eye</th>-->\r\n    <!--        </tr>-->\r\n    <!--    </thead>-->\r\n    <!--    <tbody>-->\r\n    <!--        <tr>-->\r\n    <!--            <td>{{ doc.posterior_segment or \"\" }}</td>-->\r\n    <!--            <td>FUNDUS</td>-->\r\n    <!--            <td>{{ doc.posterior_segment2 or \"\" }}</td>-->\r\n    <!--        </tr>-->\r\n    <!--    </tbody>-->\r\n    <!--</table>-->\r\n\r\n    <!-- FUNDUS DRAWING -->\r\n    <div class=\"section-title\">Posterior Segment Drawing</div>\r\n\r\n    <table class=\"fundus-table\">\r\n        <thead>\r\n            <tr>\r\n                <th>Right Eye</th>\r\n                <th>Left Eye</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td>\r\n                    {% if doc.fundus_drawing_re %}\r\n                        <img src=\"{{ doc.fundus_drawing_re }}\" style=\"width:150px;height:150px\">\r\n                    {% else %}\r\n                        <svg width=\"150\" height=\"150\" viewBox=\"0 0 200 200\">\r\n                            <g fill=\"none\" stroke=\"#16215c\" stroke-width=\"1\">\r\n                                <circle cx=\"100\" cy=\"100\" r=\"95\"/>\r\n                                <circle cx=\"100\" cy=\"100\" r=\"63\"/>\r\n                                <circle cx=\"100\" cy=\"100\" r=\"31\"/>\r\n                                <line x1=\"5\" y1=\"100\" x2=\"195\" y2=\"100\"/>\r\n                                <line x1=\"100\" y1=\"5\" x2=\"100\" y2=\"195\"/>\r\n                            </g>\r\n                            <ellipse cx=\"128\" cy=\"100\" rx=\"9\" ry=\"11\" fill=\"#fbf6ef\" stroke=\"#16215c\"/>\r\n                        </svg>\r\n                    {% endif %}\r\n                </td>\r\n                <td>\r\n                    {% if doc.fundus_drawing_le %}\r\n                        <img src=\"{{ doc.fundus_drawing_le }}\" style=\"width:150px;height:150px\">\r\n                    {% else %}\r\n                        <svg width=\"150\" height=\"150\" viewBox=\"0 0 200 200\">\r\n                            <g fill=\"none\" stroke=\"#16215c\" stroke-width=\"1\">\r\n                                <circle cx=\"100\" cy=\"100\" r=\"95\"/>\r\n                                <circle cx=\"100\" cy=\"100\" r=\"63\"/>\r\n                                <circle cx=\"100\" cy=\"100\" r=\"31\"/>\r\n                                <line x1=\"5\" y1=\"100\" x2=\"195\" y2=\"100\"/>\r\n                                <line x1=\"100\" y1=\"5\" x2=\"100\" y2=\"195\"/>\r\n                            </g>\r\n                            <ellipse cx=\"72\" cy=\"100\" rx=\"9\" ry=\"11\" fill=\"#fbf6ef\" stroke=\"#16215c\"/>\r\n                        </svg>\r\n                    {% endif %}\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- COMMENTS -->\r\n    <div class=\"section-title\">Other Comments</div>\r\n\r\n    <div class=\"comments-box\">\r\n        {{ doc.other_comments or \"\" }}\r\n    </div>\r\n\r\n    <!-- SIGNATURE -->\r\n    <!--<table class=\"signature-table\">-->\r\n    <!--    <tr>-->\r\n    <!--        <td width=\"50%\">-->\r\n    <!--            <div class=\"signature-line\"></div>-->\r\n    <!--            Doctor Signature-->\r\n    <!--        </td>-->\r\n    <!--        <td width=\"50%\">-->\r\n    <!--            <div class=\"signature-line\"></div>-->\r\n    <!--        </td>-->\r\n    <!--    </tr>-->\r\n    <!--</table>-->\r\n\r\n  \r\n\r\n</div>\r\n</main>",
