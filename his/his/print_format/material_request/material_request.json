 "html": "<style>\r\n.items-table th:nth-child(2),\r\n.items-table td:nth-child(2) {\r\n    width: 80%;\r\n}\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        color: #000;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .print-wrapper {\r\n        width: 100%;\r\n        padding: 8px 18px;\r\n    }\r\n\r\n    .brand-header {\r\n        text-align: center;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .supplier-info {\r\n        margin-bottom: 18px;\r\n        font-size: 12px;\r\n        color: #000;\r\n        \r\n    }\r\n\r\n    .supplier-title {\r\n        font-weight: bold;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .supplier-name {\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n    }\r\n\r\n    .doc-title {\r\n        text-align: center;\r\n        color: #10194f;\r\n        font-size: 22px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 4px;\r\n        margin: 8px 0 4px;\r\n    }\r\n\r\n    .title-orange-line {\r\n        width: 140px;\r\n        height: 3px;\r\n        background-color: #e36c12;\r\n        margin: 8px auto 6px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .grn-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n        font-size: 13px;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .grn-row b {\r\n        font-weight: bold;\r\n    }\r\n\r\n    .info-section {\r\n        border: 2px solid #10194f;\r\n        border-radius: 9px;\r\n        background-color: #f7f8fb;\r\n        padding: 14px 16px;\r\n        margin-bottom: 14px;\r\n        border-top: 4px solid #e36c12;\r\n         line-height: 0.6;\r\n    }\r\n\r\n    .details-grid {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        gap: 18px;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .details-grid:last-child {\r\n        margin-bottom: 0;\r\n    }\r\n\r\n    .details-cell {\r\n        width: 25%;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .details-cell-half {\r\n        width: 50%;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .details-label {\r\n        color: #10194f;\r\n        font-weight: bold;\r\n        margin-bottom: 7px;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .details-value {\r\n        color: #000;\r\n        font-weight: normal;\r\n    }\r\n\r\n    .items-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 10px;\r\n        margin-top: 10px;\r\n        \r\n    }\r\n\r\n    .items-table th {\r\n        background-color: #10194f;\r\n        color: #fff;\r\n        border: 1px solid #fff;\r\n        padding: 8px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n         line-height: 0.6;\r\n    }\r\n\r\n    .items-table th:first-child {\r\n        border-left: 1px solid #10194f;\r\n    }\r\n\r\n    .items-table th:last-child {\r\n        border-right: 1px solid #10194f;\r\n    }\r\n\r\n    .items-table td {\r\n        border: 1px solid #777;\r\n        padding: 0px;\r\n        vertical-align: top;\r\n        line-height: 0.9;\r\n        \r\n    }\r\n\r\n    .items-table tbody tr:nth-child(even) {\r\n        background-color: #f7f8fb;\r\n    }\r\n\r\n    .text-center {\r\n        text-align: center;\r\n    }\r\n\r\n    .text-right {\r\n        text-align: right;\r\n    }\r\n\r\n    .product-name {\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        color: #000;\r\n    }\r\n\r\n    .total-box {\r\n        width: 330px;\r\n        margin-left: auto;\r\n        margin-top: 10px;\r\n        border: 1px solid #777;\r\n    }\r\n\r\n    .total-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        background-color: #10194f;\r\n        color: white !important;\r\n        padding: 8px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .words-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        gap: 10px;\r\n        border-top: 3px solid #e36c12;\r\n        padding: 8px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .words-row span:first-child {\r\n        font-weight: bold;\r\n        min-width: 95px;\r\n    }\r\n\r\n    .notes-section {\r\n        margin-top: 16px;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #000;\r\n    }\r\n\r\n    .notes-section span {\r\n        font-weight: normal;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .signature-section {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 45px;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .signature-box {\r\n        width: 15%;\r\n        text-align: center;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1px solid #000;\r\n        padding-top: 6px;\r\n    }\r\n\r\n    @media print {\r\n        .print-wrapper {\r\n            padding: 5px 15px;\r\n        }\r\n\r\n        .items-table th,\r\n        .items-table td {\r\n            padding: 6px;\r\n        }\r\n        \r\n    .total-row,\r\n    .total-row span {\r\n        color: #fff !important;\r\n        background-color: #10194f !important;\r\n        -webkit-print-color-adjust: exact !important;\r\n        print-color-adjust: exact !important;\r\n    }\r\n}\r\n    }\r\n</style>\r\n\r\n<div class=\"print-wrapper\">\r\n\r\n    <!-- Letter Head / Brand -->\r\n    <div class=\"brand-header\">\r\n        {{ letter_head }}\r\n    </div>\r\n\r\n    <!-- Supplier Info -->\r\n    <div class=\"supplier-info\">\r\n       \r\n        <!--<div class=\"supplier-name\">Supplier: {{ doc.supplier or \"\" }}</div>-->\r\n    </div>\r\n\r\n    <!-- Title -->\r\n <div class=\"doc-title\">\r\n    {% if doc.material_request_type == \"Purchase\" %}\r\n        Purchase \r\n    {% endif %}\r\n    MATERIAL REQUEST\r\n</div>\r\n    <div class=\"title-orange-line\"></div>\r\n\r\n    <!-- GRN Number and Date -->\r\n    <div class=\"grn-row\">\r\n        <div>\r\n            <b>MR No.</b>\r\n            {{ doc.name or \"\" }}\r\n        </div>\r\n\r\n        <div>\r\n            <b>Dated:</b>\r\n            {{ doc.transaction_date or \"\" }}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Brand Colored Info Section -->\r\n    <div class=\"info-section\">\r\n\r\n        <div class=\"details-grid\">\r\n            <!--<div class=\"details-cell\">-->\r\n            <!--    <div class=\"details-label\">Po no.</div>-->\r\n            <!--    <div class=\"details-value\">-->\r\n            <!--        {% if doc.name and doc.name.split(\"-\")|length > 3 %}-->\r\n            <!--            {{ doc.name.split(\"-\")[3] }}-->\r\n            <!--        {% else %}-->\r\n            <!--            {{ doc.name or \"\" }}-->\r\n            <!--        {% endif %}-->\r\n            <!--    </div>-->\r\n            <!--</div>-->\r\n\r\n            <!--<div class=\"details-cell\">-->\r\n            <!--    <div class=\"details-label\">Po Date</div>-->\r\n            <!--    <div class=\"details-value\">{{ doc.posting_date or \"\" }}</div>-->\r\n            <!--</div>-->\r\n\r\n            <!--<div class=\"details-cell\">-->\r\n            <!--    <div class=\"details-label\">Suppl. Invoice</div>-->\r\n            <!--    <div class=\"details-value\">{{ doc.bill_no or \"\" }}</div>-->\r\n            <!--</div>-->\r\n\r\n            <div class=\"details-cell\">\r\n                <div class=\"details-label\">Required. Date</div>\r\n                <div class=\"details-value\">{{ doc.schedule_date or \"\" }}</div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"details-grid\">\r\n            <div class=\"details-cell-half\">\r\n                <div class=\"details-label\">Requested By</div>\r\n                <div class=\"details-value\">\r\n                    {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") or \"\" }}\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"details-cell-half\">\r\n                <div class=\"details-label\">Contact number</div>\r\n                <div class=\"details-value\">\r\n                    {{ frappe.db.get_value(\"User\", frappe.session.user, \"mobile_no\") or \"-\" }}\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- Items Table -->\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 45px;\">SN.</th>\r\n                <th style=\"text-align: left;\">PRODUCT</th>\r\n                <th style=\"width: 80px;\">UOM</th>\r\n                <th style=\"width: 80px;\">QTY</th>\r\n                <!--<th style=\"width: 90px;\">PRICE</th>-->\r\n                <!--<th style=\"width: 105px;\">AMOUNT</th>-->\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n\r\n                <td>\r\n                    <span class=\"product-name\">\r\n                        {{ frappe.db.get_value('Item', item.item_code, 'code') or \"\" }}\r\n                        {% if frappe.db.get_value('Item', item.item_code, 'code') %}\r\n                            -\r\n                        {% endif %}\r\n                        {{ item.item_code or \"\" }}\r\n                    </span>\r\n                </td>\r\n\r\n                <td class=\"text-center\">\r\n                    <b>{{ item.uom }}</b>\r\n                </td>\r\n\r\n                <td class=\"text-center\">\r\n                    <b>{{ item.qty | int }}</b>\r\n                </td>\r\n\r\n                <!--<td class=\"text-right\">-->\r\n                <!--    ${{ item.rate or 0 }}-->\r\n                <!--</td>-->\r\n\r\n                <!--<td class=\"text-right\">-->\r\n                <!--    <b>${{ item.amount or 0 }}</b>-->\r\n                <!--</td>-->\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Total -->\r\n    <!--<div class=\"total-box\">-->\r\n    <!--    <div class=\"total-row\">-->\r\n    <!--        <span>Total</span>-->\r\n    <!--        <span>${{ doc.grand_total or 0 }}</span>-->\r\n    <!--    </div>-->\r\n\r\n    <!--    <div class=\"words-row\">-->\r\n    <!--        <span>Amount in Words</span>-->\r\n    <!--        <span style=\"text-align: right; font-weight: bold;\">-->\r\n    <!--            {{ doc.in_words or \"\" }}-->\r\n    <!--        </span>-->\r\n    <!--    </div>-->\r\n    <!--</div>-->\r\n\r\n    <!-- Notes -->\r\n    <!--<div class=\"notes-section\">-->\r\n    <!--    <div style=\"margin-bottom: 6px;\">-->\r\n    <!--        Incoterm:-->\r\n    <!--        <span>{{ doc.incoterm or \"DELIVERED AT PLACE UNLOADED\" }}</span>-->\r\n    <!--    </div>-->\r\n\r\n    <!--    <div>-->\r\n    <!--        Payment Schedule:-->\r\n    <!--    </div>-->\r\n    </div>\r\n\r\n    <!-- Signatures -->\r\n    {% if doc.material_request_type == \"Purchase\" %}\r\n    <div class=\"signature-section\">\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Requested By</div>\r\n        </div>\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Verified By Purchase Officer</div>\r\n        </div>\r\n        \r\n         <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Checked By Accountant</div>\r\n        </div>\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Finance Officer</div>\r\n        </div>\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Approved By Director</div>\r\n        </div>\r\n    </div>\r\n    {% else %}\r\n     <div class=\"signature-section\">\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Requested By</div>\r\n        </div>\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Checked By</div>\r\n        </div>\r\n\r\n        <div class=\"signature-box\">\r\n            <div class=\"signature-line\">Approved By</div>\r\n        </div>\r\n    </div>\r\n    \r\n    {% endif %}\r\n</div>",
