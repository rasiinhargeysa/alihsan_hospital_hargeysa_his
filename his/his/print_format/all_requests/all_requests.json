 "css": "* {\r\n    padding: 0;\r\n    margin: 0;\r\n    box-sizing: border-box;\r\n}\r\n\r\n.mx {\r\n    width: 500px;\r\n    margin: 0 auto;\r\n}\r\n\r\nth,\r\ntd {\r\n    color: black;\r\n}\r\n\r\n.main_logo {\r\n    display: flex;\r\n    justify-content: space-evenly;\r\n    align-items: center;\r\n    border-bottom: 1px solid gray;\r\n    margin: 0px 10px;\r\n}\r\n\r\n.logo_left img {\r\n    width: 300px;\r\n    height: 100px;\r\n}\r\n\r\n.right_logo h4 {\r\n    text-align: center;\r\n}\r\n\r\n/* Main information */\r\n.mian_info {\r\n    display: flex;\r\n    width: 100%;\r\n    justify-content: space-around;\r\n    padding-top: 10px;\r\n}\r\n\r\n.info_2 {\r\n    margin-left: 100px;\r\n}\r\n\r\n.info_id,\r\n.info_age,\r\n.info_doctor {\r\n    display: flex;\r\n}\r\n\r\n.info_id_2,\r\n.info_age_2,\r\n.info_doctor_2 {\r\n    display: flex;\r\n}\r\n\r\n.info_id h4 {\r\n    color: #9478a9;\r\n    padding-left: 100px;\r\n}\r\n\r\n.info_age h4 {\r\n    color: #9478a9;\r\n    padding-left: 90px;\r\n}\r\n\r\n.info_doctor h4 {\r\n    color: #9478a9;\r\n    padding-left: 64px;\r\n}\r\n\r\n.info_id_2 h4 {\r\n    color: #9478a9;\r\n    padding-left: 100px;\r\n}\r\n\r\n.info_age_2 h4 {\r\n    color: #9478a9;\r\n    padding-left: 127px;\r\n}\r\n\r\n.info_doctor_2 h4 {\r\n    color: #9478a9;\r\n    padding-left: 117px;\r\n}\r\n\r\n.info_id h3,\r\n.info_age h3,\r\n.info_doctor h3 {\r\n    color: #153b50;\r\n}\r\n\r\n/* Tables */\r\n.table_section {\r\n    width: 100%;\r\n    padding-top: 0;\r\n    margin: 0;\r\n}\r\n\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n}\r\n\r\ntable th,\r\ntable td {\r\n    border-bottom: 1px solid gray;\r\n    border-top: 1px solid gray;\r\n    padding: 5px;\r\n    line-height: 1.2;\r\n}\r\n\r\nth {\r\n    color: black;\r\n    font-size: 14px;\r\n    font-weight: bold;\r\n}\r\n\r\ntable th {\r\n    text-align: left;\r\n    color: gray;\r\n    font-size: 14px;\r\n    font-weight: bold;\r\n}\r\n\r\n/* Footer */\r\n.signature {\r\n    display: flex;\r\n    justify-content: center;\r\n    height: 100px;\r\n    align-items: center;\r\n    color: #342042;\r\n}\r\n\r\n.bukanka {\r\n    display: flex;\r\n    justify-content: center;\r\n    color: #3e30c2;\r\n    border-bottom: 2px dotted #1c146b;\r\n    padding: 10px 0;\r\n}\r\n\r\n.days {\r\n    color: red;\r\n}\r\n\r\n.address {\r\n    display: flex;\r\n    justify-content: center;\r\n    padding-top: 20px;\r\n    color: #342042;\r\n}\r\n\r\n.address h4 {\r\n    font-size: 14px;\r\n}\r\n\r\n.address h4 span {\r\n    padding: 0 5px;\r\n}\r\n\r\n/* Page break */\r\n.page-break {\r\n    page-break-before: always;\r\n    break-before: page;\r\n}",
 "custom_format": 1,
