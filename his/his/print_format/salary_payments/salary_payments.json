 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"salpay-pf\">\r\n<style>\r\n  .salpay-pf, .salpay-pf * {\r\n    font-family: Calibri, 'Segoe UI', Arial, Helvetica, sans-serif !important;\r\n    color: #1a1a1a !important;\r\n    text-decoration: none;\r\n    box-sizing: border-box;\r\n  }\r\n  .salpay-pf { font-size: 11.5px; line-height: 0.8; }\r\n\r\n  .salpay-pf .eyebrow {\r\n    font-size: 10px !important;\r\n    font-weight: 700 !important;\r\n    color: #10194F !important;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n    margin: 16px 0 2px 0;\r\n  }\r\n  .salpay-pf .title {\r\n    font-size: 20px !important;\r\n    font-weight: 800 !important;\r\n    color: #10194F !important;\r\n    letter-spacing: 1px;\r\n    margin: 0 0 4px 0;\r\n  }\r\n  .salpay-pf .ref-no {\r\n    font-size: 11.5px !important;\r\n    color: #555 !important;\r\n    margin-bottom: 14px;\r\n  }\r\n\r\n  .salpay-pf .info-box {\r\n    border: 1.5px solid #10194F;\r\n    background: #F7F8FB;\r\n    border-radius: 4px;\r\n    padding: 12px 18px;\r\n    margin-bottom: 16px;\r\n  }\r\n  .salpay-pf .info-table { width: 100%; border-collapse: collapse; }\r\n  .salpay-pf .info-table td { border: none; padding: 3px 10px 3px 0; vertical-align: top; font-size: 11.5px; }\r\n  .salpay-pf .info-label { font-weight: 700 !important; color: #10194F !important; white-space: nowrap; }\r\n\r\n  .salpay-pf table.items {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 4px;\r\n  }\r\n  .salpay-pf table.items th {\r\n    background: #10194F !important;\r\n    color: #fff !important;\r\n    font-size: 10.5px !important;\r\n    font-weight: 700 !important;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2px;\r\n    padding: 7px 8px;\r\n    text-align: left;\r\n    border: 1px solid #10194F;\r\n  }\r\n  .salpay-pf table.items th * { color: #fff !important; }\r\n  .salpay-pf table.items td {\r\n    font-size: 10.5px !important;\r\n    padding: 6px 8px;\r\n    border: 1px solid #d9d9d9;\r\n    vertical-align: top;\r\n  }\r\n  .salpay-pf table.items tr:nth-child(even) td { background: #F7F8FB; }\r\n  .salpay-pf table.items .num { text-align: right; white-space: nowrap; }\r\n  .salpay-pf table.items .center { text-align: center; }\r\n\r\n  .salpay-pf .total-box {\r\n    display: table;\r\n    width: 100%;\r\n    margin-top: 10px;\r\n    border: 1.5px solid #10194F;\r\n    border-radius: 4px;\r\n    overflow: hidden;\r\n  }\r\n  .salpay-pf .total-row {\r\n    display: table-row;\r\n  }\r\n  .salpay-pf .total-row.head { background: #10194F !important; }\r\n  .salpay-pf .total-row.head .total-cell { color: #fff !important; font-weight: 700 !important; }\r\n  .salpay-pf .total-cell {\r\n    display: table-cell;\r\n    padding: 8px 16px;\r\n    font-size: 12px !important;\r\n    width: 50%;\r\n  }\r\n  .salpay-pf .total-cell.right { text-align: right; }\r\n\r\n  .salpay-pf .payroll-ref {\r\n    margin-top: 10px;\r\n    font-size: 11px !important;\r\n    color: #555 !important;\r\n  }\r\n  .salpay-pf .payroll-ref b { color: #10194F !important; }\r\n\r\n  .salpay-pf .sign-section { margin-top: 40px; }\r\n  .salpay-pf .sign-section .sign-title {\r\n    font-size: 11px !important;\r\n    font-weight: 700 !important;\r\n    color: #10194F !important;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.5px;\r\n    margin-bottom: 10px;\r\n    border-bottom: 1px solid #d9d9d9;\r\n    padding-bottom: 6px;\r\n  }\r\n  .salpay-pf .sign-grid {\r\n    display: table;\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    border: 1.5px solid #10194F;\r\n    border-radius: 4px;\r\n    overflow: hidden;\r\n  }\r\n  .salpay-pf .sign-grid .sign-row { display: table-row; }\r\n  .salpay-pf .sign-grid .sign-cell {\r\n    display: table-cell;\r\n    width: 50%;\r\n    padding: 16px 18px 26px 18px;\r\n    font-size: 11.5px !important;\r\n    vertical-align: top;\r\n  }\r\n  .salpay-pf .sign-grid .sign-row:first-child .sign-cell { border-bottom: 1px solid #10194F; }\r\n  .salpay-pf .sign-grid .sign-row .sign-cell:first-child { border-right: 1px solid #10194F; }\r\n  .salpay-pf .sign-role {\r\n    font-weight: 700 !important;\r\n    color: #10194F !important;\r\n    text-transform: uppercase;\r\n    font-size: 10px !important;\r\n    letter-spacing: 0.4px;\r\n    display: block;\r\n    margin-bottom: 14px;\r\n  }\r\n  .salpay-pf .sign-fill-line {\r\n    display: inline-block;\r\n    border-bottom: 1px solid #999;\r\n    min-width: 170px;\r\n    height: 14px;\r\n  }\r\n  .salpay-pf .sign-name-date { margin-top: 4px; }\r\n  .salpay-pf .sign-name-date span { display: inline-block; margin-right: 24px; }\r\n</style>\r\n\r\n{{ letter_head }}\r\n\r\n\r\n<div class=\"title\">Salary Payments</div>\r\n<div class=\"ref-no\">{{ doc.name }}</div>\r\n\r\n<div class=\"info-box\">\r\n  <table class=\"info-table\">\r\n    <tr>\r\n      <td class=\"info-label\">From Date:</td>\r\n      <td>{{ frappe.utils.formatdate(doc.from_date) if doc.from_date else \"\" }}</td>\r\n      <td class=\"info-label\">To Date:</td>\r\n      <td>{{ frappe.utils.formatdate(doc.to_date) if doc.to_date else \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"info-label\">Account:</td>\r\n      <td colspan=\"3\">{{ doc.account or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"info-label\">Transaction Date:</td>\r\n      <td>{{ frappe.utils.formatdate(doc.posting_date) if doc.posting_date else \"\" }}</td>\r\n      <td class=\"info-label\">Payroll Entry:</td>\r\n      <td>{{ doc.payroll_entry or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n</div>\r\n\r\n<table class=\"items\">\r\n  <thead>\r\n    <tr>\r\n      <th style=\"width:4%;\">Sr</th>\r\n      <th style=\"width:10%;\">Employee</th>\r\n      <th style=\"width:16%;\">Employee Name</th>\r\n      <th style=\"width:13%;\">Department</th>\r\n      <th style=\"width:9%;\">Amount</th>\r\n      <th style=\"width:9%;\">Payment</th>\r\n      <th style=\"width:8%;\">Balance</th>\r\n   \r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% set total_amount = namespace(value=0) %}\r\n    {% set total_payment = namespace(value=0) %}\r\n    {% for row in doc.salary_payments_details %}\r\n    <tr>\r\n      <td class=\"center\">{{ loop.index }}</td>\r\n      <td>{{ row.employee or \"\" }}</td>\r\n      <td>{{ row.employee_name or \"\" }}</td>\r\n      <td>{{ row.department or \"\" }}</td>\r\n      <td class=\"num\">$ {{ \"%.2f\"|format(row.amount or 0) }}</td>\r\n      <td class=\"num\">$ {{ \"%.2f\"|format(row.payment or 0) }}</td>\r\n      <td class=\"num\">$ {{ \"%.2f\"|format(row.balance or 0) }}</td>\r\n   \r\n    </tr>\r\n    {% set total_amount.value = total_amount.value + (row.amount or 0) %}\r\n    {% set total_payment.value = total_payment.value + (row.payment or 0) %}\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<div class=\"total-box\">\r\n  <div class=\"total-row head\">\r\n    <div class=\"total-cell\">Total Amount: $ {{ \"%.2f\"|format(total_amount.value) }}</div>\r\n    <div class=\"total-cell right\">Total Payment: $ {{ \"%.2f\"|format(total_payment.value) }}</div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"sign-section\">\r\n  <div class=\"sign-title\">Authorization</div>\r\n  <div class=\"sign-grid\">\r\n    <div class=\"sign-row\">\r\n      <div class=\"sign-cell\">\r\n        <span class=\"sign-role\">1. Prepared By \u2014 Chief Accountant</span>\r\n        <span class=\"sign-fill-line\"></span>\r\n        <div class=\"sign-name-date\"><span>Name: ______________</span></div>\r\n      </div>\r\n      <div class=\"sign-cell\">\r\n        <span class=\"sign-role\">2. Checked By \u2014 HR</span>\r\n        <span class=\"sign-fill-line\"></span>\r\n        <div class=\"sign-name-date\"><span>Name: ______________</span></div>\r\n      </div>\r\n    </div>\r\n    <div class=\"sign-row\">\r\n      <div class=\"sign-cell\">\r\n        <span class=\"sign-role\">3. Approved By \u2014 Finance</span>\r\n        <span class=\"sign-fill-line\"></span>\r\n        <div class=\"sign-name-date\"><span>Name: ______________</span></div>\r\n      </div>\r\n      <div class=\"sign-cell\">\r\n        <span class=\"sign-role\">4. Approved By</span>\r\n        <span class=\"sign-fill-line\"></span>\r\n        <div class=\"sign-name-date\"><span>Name: ______________</span></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n</div>",
