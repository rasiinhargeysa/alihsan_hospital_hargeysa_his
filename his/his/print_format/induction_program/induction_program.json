 "font_size": 14,
 "html": "<style>\r\n    .ip-header-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px; }\r\n    .ip-header-table td { padding: 4px 0; border: none; }\r\n    .ip-label { font-weight: bold; width: 18%; }\r\n    .ip-underline { border-bottom: 1px solid #000; }\r\n\r\n    .ip-table { width: 100%; border-collapse: collapse; font-size: 11px; }\r\n    .ip-table th, .ip-table td {\r\n        border: 1px solid #000; padding: 5px 6px; vertical-align: top; text-align: left;\r\n    }\r\n    .ip-table th { font-weight: bold; }\r\n    .ip-section-col { font-weight: bold; width: 12%; }\r\n    .ip-date-col { width: 9%; }\r\n    .ip-contact-col { width: 15%; }\r\n    .ip-sig-col { width: 12%; }\r\n\r\n    .ip-footer-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 16px; }\r\n    .ip-footer-table td { border: none; padding: 6px 0; }\r\n</style>\r\n\r\n<div style=\"margin-bottom: 10px;\">\r\n    {{ letter_head }}\r\n</div>\r\n\r\n<h2 style=\"text-align:center; margin-bottom: 16px;\">Induction Program</h2>\r\n\r\n<table class=\"ip-header-table\">\r\n    <tr>\r\n        <td class=\"ip-label\">Employee Name:</td>\r\n        <td class=\"ip-underline\">{{ doc.employee_name or \"\" }}</td>\r\n        <td class=\"ip-label\" style=\"padding-left: 30px;\">Joining Date:</td>\r\n        <td class=\"ip-underline\">{{ doc.get_formatted(\"joining_date\") or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"ip-label\">Job Title:</td>\r\n        <td class=\"ip-underline\">{{ doc.job_title or \"\" }}</td>\r\n        <td class=\"ip-label\" style=\"padding-left: 30px;\">Employee Code:</td>\r\n        <td class=\"ip-underline\">{{ doc.employee or \"\" }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"ip-label\">Department:</td>\r\n        <td class=\"ip-underline\">{{ doc.department or \"\" }}</td>\r\n        <td class=\"ip-label\" style=\"padding-left: 30px;\">Department:</td>\r\n        <td class=\"ip-underline\">{{ doc.department or \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"ip-table\">\r\n    <thead>\r\n        <tr>\r\n            <th class=\"ip-date-col\">Date</th>\r\n            <th class=\"ip-section-col\">Section</th>\r\n            <th>Key Activities</th>\r\n            <th class=\"ip-contact-col\">Contact Person</th>\r\n            <th class=\"ip-sig-col\">Inductee Signature</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for row in doc.induction_program_item %}\r\n        <tr>\r\n            <td>{{ row.get_formatted(\"date\") or \"\" }}</td>\r\n            <td>{{ row.section or \"\" }}</td>\r\n            <td style=\"white-space: pre-line;\">{{ row.key_activities or \"\" }}</td>\r\n            <td>{{ row.contact_person or \"\" }}</td>\r\n            <td>&nbsp;</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<table class=\"ip-footer-table\">\r\n    <tr>\r\n        <td style=\"width: 50%;\">Line Manager: __________________________</td>\r\n        <td style=\"width: 50%;\">Date: __________________________</td>\r\n    </tr>\r\n    <tr>\r\n        <td colspan=\"2\">\r\n            <b>Note:</b> Completed form should be returned to the Human Resource Manager.\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <td></td>\r\n        <td>HR Manager: __________________________</td>\r\n    </tr>\r\n</table>",
