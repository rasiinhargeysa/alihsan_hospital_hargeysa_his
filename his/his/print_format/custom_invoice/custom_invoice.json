 "html": "{{ letter_head }}\r\n<h1 style=\"font-weight: bold; text-align: center;\">PAYMENT REQUEST</h1>\r\n    <header class=\"header mx\">\r\n        \r\n   \r\n      <div class=\"header_right\">\r\n       \r\n        <span> <b>From: </b>Al Ihsan Specialist hospital</span>\r\n          <span> <b>To:</b> {{doc.customer_name}}</span>\r\n          <span><b>Purpose:</b> Invoice</span>\r\n           <span><b> Date:</b> {{ doc.date }}</span>\r\n      </div>\r\n      \r\n      <div class=\"header_right\">\r\n        <span> <b>Address: </b>26 june, Berta Xorriyada, Hargeysa</span>\r\n        <span><b>Tell:</b> 0639666626/0639666627 </span>\r\n        <span><b>Email: </b>finance@alihsahospitals.com</span>\r\n        <span> <b>Website:</b> alihsahospitals.com</span>\r\n      </div>\r\n    </header>\r\n    <section class=\"dahir_table_sec mx\">\r\n      <table style=\"width: 100%\">\r\n        <thead>\r\n          <tr>\r\n            <th style=\"width: 30px; text-align: start; padding-left: 2px; font-weight: bold;\">No</th>\r\n            <th style=\"width: 45%; text-align: start; padding-left: 15px; font-weight: bold; \">Name</th>\r\n            <th style=\"width: 15%; text-align: start; padding-left: 5px; font-weight: bold;\">Tell Number</th>\r\n            <!--<th style=\"text-align: start; padding-left: 5px\">Amount</th>-->\r\n            <th style=\"text-align: end; font-weight: bold;\" >Amount</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr>\r\n            <th style=\"width: 30px; text-align: start\">1</th>\r\n            <th\r\n              style=\"\r\n                width: 45%;\r\n                text-align: start;\r\n                text-transform: uppercase;\r\n                font-size: 14px;\r\n                padding-left: 5px;\r\n              \"\r\n            >\r\n             {{doc.customer_name}}\r\n            </th>\r\n            <th style=\"width: 15%; text-align: start; padding-left: 5px\">{{doc.mobile or \"\"}}</th>\r\n            <th style=\"text-align: end; padding-right: 5px\">${{doc.balance or 0}}</th>\r\n           \r\n          </tr>\r\n          \r\n                <tr>\r\n           \r\n              <th style=\"text-align: start; padding-left: 5px;   border-left: 1px solid white;    border-bottom: 1px solid white;  \" colspan= \"2\"></th>\r\n          \r\n            <th style=\"text-align: start; padding-left: 5px ;  border-right: 1px solid white; \">Total</th>\r\n            <th style=\"text-align: start; padding-left: 5px; border-left: 1px solid white; text-align: right;\">${{doc.balance}}</th>\r\n         \r\n          </tr>\r\n          \r\n        \r\n          \r\n          <tr>\r\n           \r\n              <th style=\"text-align: start; padding-left: 5px;   border-left: 1px solid white;    border-bottom: 1px solid white;  \" colspan= \"2\"></th>\r\n          \r\n            <th style=\"text-align: start; padding-left: 5px ;   border-right: 1px solid white;\" >Net Amount</th>\r\n            <th style=\"text-align: start; padding-left: 5px; border-left: 1px solid white; text-align: right;\"> ${{ doc.net_amount}}</th>\r\n         \r\n          </tr>\r\n          \r\n          \r\n          \r\n        </tbody>\r\n      </table>\r\n    </section>\r\n    <footer class=\"footer mx\">\r\n      <span style=\"font-size: 16px\"\r\n        ><B></B> Al Ihsan Cheif Accountat </span>\r\n         <span style=\"font-size: 16px\"\r\n        ><B>Name: </B> Abdalla Jama Shire </span>\r\n   \r\n\r\n      <span style=\"font-size: 16px\"><b>E-Dahab Marchent: </b>763207</span>\r\n       <span style=\"font-size: 16px\"><b>ZAAD Marchent: </b>481926</span>\r\n       <span style=\"font-size: 16px\"><b>DAHABSHIIL BANK: </b>208017775301</span>\r\n      <span  style=\"font-size: 16px\"><b>Signature:</b> _________________</span>\r\n      \r\n    \r\n    </footer>",
