{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-09-22 17:06:03.411348",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Monthly Budget",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n\r\n    <meta charset=\"UTF-8\">\r\n\r\n    <style>\r\n\r\n        @page {\r\n            size: A4;\r\n            margin: 10mm 12mm;\r\n        }\r\n\r\n        :root {\r\n            --blue: #101B5C;\r\n            --blue-light: #173B8F;\r\n            --orange: #F58220;\r\n            --border: #7D8795;\r\n            --border-light: #D1D5DB;\r\n            --light: #F5F6F8;\r\n            --text: #111827;\r\n            --muted: #5F6673;\r\n            --white: #FFFFFF;\r\n        }\r\n\r\n        * {\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            margin: 0;\r\n            padding: 0;\r\n            font-family: Arial, Helvetica, sans-serif;\r\n            color: var(--text);\r\n            font-size: 10px;\r\n            background: #FFFFFF;\r\n        }\r\n\r\n        .page {\r\n            width: 100%;\r\n        }\r\n\r\n        /* =========================================\r\n           LETTER HEAD\r\n        ========================================== */\r\n\r\n        .letter-head {\r\n            width: 100%;\r\n            margin-bottom: 5px;\r\n        }\r\n\r\n        .letter-head img {\r\n            max-width: 100%;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           DOCUMENT TITLE\r\n        ========================================== */\r\n\r\n        .document-title {\r\n            text-align: center;\r\n            margin-top: 5px;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .document-title h1 {\r\n            margin: 0;\r\n            color: var(--blue);\r\n            font-size: 23px;\r\n            font-weight: 800;\r\n            letter-spacing: 4px;\r\n        }\r\n\r\n        .title-line {\r\n            width: 140px;\r\n            height: 3px;\r\n            background: var(--orange);\r\n            margin: 7px auto 0;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           DOCUMENT META\r\n        ========================================== */\r\n\r\n        .document-meta {\r\n            width: 100%;\r\n            display: table;\r\n            margin-bottom: 10px;\r\n            font-size: 10px;\r\n        }\r\n\r\n        .document-meta-left,\r\n        .document-meta-right {\r\n            display: table-cell;\r\n            vertical-align: middle;\r\n        }\r\n\r\n        .document-meta-left {\r\n            width: 60%;\r\n            color: var(--blue);\r\n        }\r\n\r\n        .document-meta-right {\r\n            width: 40%;\r\n            text-align: right;\r\n            color: var(--text);\r\n        }\r\n\r\n        .document-meta strong {\r\n            font-weight: 700;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           INFORMATION BOX\r\n        ========================================== */\r\n\r\n        .info-box {\r\n            width: 100%;\r\n            border: 1px solid var(--border);\r\n            border-top: 3px solid var(--orange);\r\n            background: #FAFBFC;\r\n            padding: 8px 12px;\r\n            margin-bottom: 14px;\r\n        }\r\n\r\n        .info-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n        .info-table td {\r\n            padding: 3px 4px;\r\n            vertical-align: middle;\r\n            font-size: 10px;\r\n        }\r\n\r\n        .info-label {\r\n            width: 15%;\r\n            color: var(--blue);\r\n            font-weight: 700;\r\n            white-space: nowrap;\r\n        }\r\n\r\n        .info-value {\r\n            width: 35%;\r\n            color: var(--text);\r\n            font-weight: 500;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           STATUS\r\n        ========================================== */\r\n\r\n        .status {\r\n            display: inline-block;\r\n            padding: 3px 10px;\r\n            background: #EEF2FF;\r\n            border: 1px solid #C8D2F0;\r\n            color: var(--blue);\r\n            border-radius: 3px;\r\n            font-size: 8px;\r\n            font-weight: 700;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.4px;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           SECTION TITLE\r\n        ========================================== */\r\n\r\n        .section-title {\r\n            margin: 7px 0 6px;\r\n            color: var(--blue);\r\n            font-size: 11px;\r\n            font-weight: 800;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.3px;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           ACCOUNTS TABLE\r\n        ========================================== */\r\n\r\n        .accounts-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            table-layout: fixed;\r\n        }\r\n\r\n        .accounts-table thead th {\r\n            background: var(--blue);\r\n            color: var(--white);\r\n            padding: 8px;\r\n            border: 1px solid var(--white);\r\n            font-size: 9px;\r\n            font-weight: 800;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.3px;\r\n        }\r\n\r\n        .accounts-table thead th:first-child {\r\n            width: 42px;\r\n            text-align: center;\r\n        }\r\n\r\n        .accounts-table thead th:nth-child(2) {\r\n            text-align: left;\r\n        }\r\n\r\n        .accounts-table thead th:last-child {\r\n            width: 140px;\r\n            text-align: right;\r\n        }\r\n\r\n        .accounts-table tbody td {\r\n            padding: 8px;\r\n            border: 1px solid #AEB5BE;\r\n            font-size: 9px;\r\n            color: var(--text);\r\n            background: var(--white);\r\n            vertical-align: middle;\r\n        }\r\n\r\n        .accounts-table tbody tr:nth-child(even) td {\r\n            background: #F7F8FA;\r\n        }\r\n\r\n        .serial {\r\n            text-align: center;\r\n            color: var(--blue);\r\n            font-weight: 700;\r\n        }\r\n\r\n        .account {\r\n            font-weight: 600;\r\n        }\r\n\r\n        .amount {\r\n            text-align: right;\r\n            white-space: nowrap;\r\n            font-weight: 700;\r\n            color: var(--blue);\r\n        }\r\n\r\n        .empty-row {\r\n            text-align: center;\r\n            color: var(--muted);\r\n            font-style: italic;\r\n            padding: 12px !important;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           TOTAL\r\n        ========================================== */\r\n\r\n        .total-container {\r\n            width: 100%;\r\n            margin-top: 11px;\r\n            display: table;\r\n        }\r\n\r\n        .total-spacer {\r\n            display: table-cell;\r\n        }\r\n\r\n        .total-box {\r\n            display: table-cell;\r\n            width: 350px;\r\n            border: 1px solid #888F99;\r\n            vertical-align: top;\r\n        }\r\n\r\n        .total-header {\r\n            display: table;\r\n            width: 100%;\r\n            background: var(--blue);\r\n            color: var(--white);\r\n            border-bottom: 3px solid var(--orange);\r\n        }\r\n\r\n        .total-label {\r\n            display: table-cell;\r\n            padding: 7px 9px;\r\n            font-size: 10px;\r\n            font-weight: 800;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n               .total-value {\r\n                display: table-cell;\r\n                padding: 7px 9px;\r\n                text-align: right;\r\n                font-size: 13px;\r\n                font-weight: 800;\r\n                white-space: nowrap;\r\n                color: #FFFFFF;\r\n            }\r\n\r\n\r\n        .amount-words {\r\n            display: table;\r\n            width: 100%;\r\n            min-height: 38px;\r\n            background: #FAFBFC;\r\n        }\r\n\r\n        .amount-words-label {\r\n            display: table-cell;\r\n            width: 105px;\r\n            padding: 7px;\r\n            color: var(--blue);\r\n            font-weight: 700;\r\n            font-size: 8px;\r\n            vertical-align: top;\r\n            white-space: nowrap;\r\n        }\r\n\r\n        .amount-words-value {\r\n            display: table-cell;\r\n            padding: 7px;\r\n            text-align: right;\r\n            color: var(--text);\r\n            font-size: 8.5px;\r\n            font-weight: 600;\r\n            vertical-align: top;\r\n            line-height: 1.4;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           APPROVAL\r\n        ========================================== */\r\n\r\n        .approval-section {\r\n            width: 100%;\r\n            margin-top: 32px;\r\n            display: table;\r\n            page-break-inside: avoid;\r\n        }\r\n\r\n        .approval-cell {\r\n            display: table-cell;\r\n            width: 50%;\r\n            padding-right: 35px;\r\n        }\r\n\r\n        .approval-cell:last-child {\r\n            padding-left: 35px;\r\n            padding-right: 0;\r\n        }\r\n\r\n        .approval-line {\r\n            height: 30px;\r\n            border-bottom: 1px solid #555;\r\n        }\r\n\r\n        .approval-label {\r\n            margin-top: 5px;\r\n            color: var(--blue);\r\n            font-size: 9px;\r\n            font-weight: 700;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           FOOTER\r\n        ========================================== */\r\n\r\n        .footer {\r\n            margin-top: 22px;\r\n            padding-top: 7px;\r\n            border-top: 1px solid var(--border-light);\r\n            display: table;\r\n            width: 100%;\r\n            color: #6B7280;\r\n            font-size: 8px;\r\n            page-break-inside: avoid;\r\n        }\r\n\r\n        .footer-left {\r\n            display: table-cell;\r\n            width: 50%;\r\n        }\r\n\r\n        .footer-right {\r\n            display: table-cell;\r\n            width: 50%;\r\n            text-align: right;\r\n        }\r\n\r\n        .footer-brand {\r\n            color: var(--blue);\r\n            font-weight: 700;\r\n        }\r\n\r\n\r\n        /* =========================================\r\n           PRINT\r\n        ========================================== */\r\n\r\n        @media print {\r\n\r\n            body {\r\n                background: #FFFFFF;\r\n            }\r\n\r\n            .page {\r\n                width: 100%;\r\n            }\r\n\r\n            .accounts-table {\r\n                page-break-inside: auto;\r\n            }\r\n\r\n            .accounts-table tr {\r\n                page-break-inside: avoid;\r\n            }\r\n\r\n            .accounts-table thead {\r\n                display: table-header-group;\r\n            }\r\n\r\n            .info-box,\r\n            .total-box,\r\n            .approval-section,\r\n            .footer {\r\n                page-break-inside: avoid;\r\n            }\r\n        }\r\n\r\n    </style>\r\n\r\n</head>\r\n\r\n\r\n<body>\r\n\r\n<div class=\"page\">\r\n\r\n\r\n    <!-- =========================================\r\n         LETTER HEAD\r\n    ========================================== -->\r\n\r\n    <div class=\"letter-head\">\r\n        {{ letter_head }}\r\n    </div>\r\n\r\n\r\n    <!-- =========================================\r\n         DOCUMENT TITLE\r\n    ========================================== -->\r\n\r\n    <div class=\"document-title\">\r\n\r\n        <h1>\r\n            MONTHLY DOCUMENT\r\n        </h1>\r\n\r\n        <div class=\"title-line\"></div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =========================================\r\n         DOCUMENT NUMBER / DATE\r\n    ========================================== -->\r\n\r\n    <div class=\"document-meta\">\r\n\r\n        <div class=\"document-meta-left\">\r\n\r\n            <strong>\r\n                Document No.\r\n            </strong>\r\n\r\n            {{ doc.name }}\r\n\r\n        </div>\r\n\r\n\r\n        <div class=\"document-meta-right\">\r\n\r\n            <strong>\r\n                Dated:\r\n            </strong>\r\n\r\n            {{ doc.date }}\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =========================================\r\n         DOCUMENT INFORMATION\r\n    ========================================== -->\r\n\r\n    <div class=\"info-box\">\r\n\r\n        <table class=\"info-table\">\r\n\r\n            <tr>\r\n\r\n                <td class=\"info-label\">\r\n                    Doc. No.\r\n                </td>\r\n\r\n                <td class=\"info-value\">\r\n                    {{ doc.name }}\r\n                </td>\r\n\r\n                <td class=\"info-label\">\r\n                    Date\r\n                </td>\r\n\r\n                <td class=\"info-value\">\r\n                    {{ doc.date }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n\r\n            <tr>\r\n\r\n                <td class=\"info-label\">\r\n                    Month\r\n                </td>\r\n\r\n                <td class=\"info-value\">\r\n                    {{ doc.month }}\r\n                </td>\r\n\r\n                <td class=\"info-label\">\r\n                    Status\r\n                </td>\r\n\r\n                <td class=\"info-value\">\r\n\r\n                    <span class=\"status\">\r\n\r\n                        {% if doc.docstatus == 0 %}\r\n                            Draft\r\n                        {% elif doc.docstatus == 1 %}\r\n                            Submitted\r\n                        {% elif doc.docstatus == 2 %}\r\n                            Cancelled\r\n                        {% else %}\r\n                            {{ doc.docstatus }}\r\n                        {% endif %}\r\n\r\n                    </span>\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =========================================\r\n         DOCUMENT DETAILS\r\n    ========================================== -->\r\n\r\n    <div class=\"section-title\">\r\n        DOCUMENT DETAILS\r\n    </div>\r\n\r\n\r\n    <table class=\"accounts-table\">\r\n\r\n        <thead>\r\n\r\n            <tr>\r\n\r\n                <th>\r\n                    SN.\r\n                </th>\r\n\r\n                <th>\r\n                    ACCOUNT\r\n                </th>\r\n\r\n                <th>\r\n                    AMOUNT\r\n                </th>\r\n\r\n            </tr>\r\n\r\n        </thead>\r\n\r\n\r\n        <tbody>\r\n\r\n            {% for item in doc.accounts %}\r\n\r\n            <tr>\r\n\r\n                <td class=\"serial\">\r\n                    {{ loop.index }}\r\n                </td>\r\n\r\n                <td class=\"account\">\r\n                    {{ item.account }}\r\n                </td>\r\n\r\n                <td class=\"amount\">\r\n\r\n                    {{ item.currency|default(\"$\") }}\r\n\r\n                    {{ \"%.2f\"|format(item.budget_amount|default(0)) }}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% else %}\r\n\r\n            <tr>\r\n\r\n                <td colspan=\"3\" class=\"empty-row\">\r\n                    No account details available.\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endfor %}\r\n\r\n        </tbody>\r\n\r\n    </table>\r\n\r\n\r\n    <!-- =========================================\r\n         CALCULATE TOTAL FROM CHILD TABLE\r\n    ========================================== -->\r\n\r\n    {% set ns = namespace(total=0) %}\r\n\r\n    {% for item in doc.accounts %}\r\n\r\n        {% set ns.total = ns.total + (item.budget_amount or 0) %}\r\n\r\n    {% endfor %}\r\n\r\n\r\n    <!-- =========================================\r\n         TOTAL\r\n    ========================================== -->\r\n\r\n    <div class=\"total-container\">\r\n\r\n        <div class=\"total-spacer\"></div>\r\n\r\n        <div class=\"total-box\">\r\n\r\n\r\n            <div class=\"total-header\">\r\n\r\n                <div class=\"total-label\">\r\n                    Total\r\n                </div>\r\n\r\n                <div class=\"total-value\">\r\n\r\n                    {{ doc.currency|default(\"$\") }}\r\n\r\n                    {{ \"%.2f\"|format(ns.total) }}\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"amount-words\">\r\n\r\n                <div class=\"amount-words-label\">\r\n                    Amount in Words\r\n                </div>\r\n\r\n                <div class=\"amount-words-value\">\r\n\r\n                    {{ frappe.utils.money_in_words(\r\n                        ns.total,\r\n                        doc.currency|default(\"USD\")\r\n                    ) }}\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =========================================\r\n         APPROVAL / SIGNATURE\r\n    ========================================== -->\r\n\r\n    <div class=\"approval-section\">\r\n\r\n\r\n        <div class=\"approval-cell\">\r\n\r\n            <div class=\"approval-line\"></div>\r\n\r\n            <div class=\"approval-label\">\r\n                Prepared By\r\n            </div>\r\n\r\n        </div>\r\n\r\n\r\n        <div class=\"approval-cell\">\r\n\r\n            <div class=\"approval-line\"></div>\r\n\r\n            <div class=\"approval-label\">\r\n                Approved By\r\n            </div>\r\n\r\n        </div>\r\n\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =========================================\r\n         FOOTER\r\n    ========================================== -->\r\n\r\n    <div class=\"footer\">\r\n\r\n\r\n        <div class=\"footer-left\">\r\n\r\n            <span class=\"footer-brand\">\r\n                {{ doc.name }}\r\n            </span>\r\n\r\n        </div>\r\n\r\n\r\n        <div class=\"footer-right\">\r\n\r\n            Monthly Document\r\n\r\n        </div>\r\n\r\n\r\n    </div>\r\n\r\n\r\n</div>\r\n\r\n</body>\r\n\r\n</html>\r\n",
