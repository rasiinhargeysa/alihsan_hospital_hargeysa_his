 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    .print-format {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 12px;\r\n        color: #333;\r\n        padding: 10px;\r\n    }\r\n\r\n    .print-format .patient-box {\r\n        border: 1px solid #16215c;\r\n        border-radius: 8px;\r\n        padding: 8px 15px !important;\r\n        margin-bottom: 10px;\r\n        background-color: #fbf6ef;\r\n    }\r\n\r\n    .print-format .patient-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .print-format .patient-table td {\r\n        border: none;\r\n        vertical-align: top;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        padding: 0 !important;\r\n    }\r\n\r\n    .print-format .report-title {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        font-weight: 800;\r\n        color: #16215c;\r\n        letter-spacing: 3px;\r\n        margin-top: 10px;\r\n        margin-bottom: 4px;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .print-format .report-title-underline {\r\n        width: 160px;\r\n        height: 3px;\r\n        background-color: #f5821f;\r\n        margin: 0 auto 15px;\r\n    }\r\n\r\n    .print-format .section-title {\r\n        background: #16215c;\r\n        color: #fff;\r\n        border-radius: 6px 6px 0 0;\r\n        padding: 6px 10px !important;\r\n        font-weight: bold;\r\n        margin-top: 12px;\r\n        letter-spacing: 0.5px;\r\n    }\r\n\r\n    .print-format .eye-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 0;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .print-format .eye-table th,\r\n    .print-format .eye-table td {\r\n        border: 1px solid #ccc;\r\n        padding: 3px 8px !important;\r\n        font-size: 12px;\r\n       \r\n    }\r\n\r\n    .print-format .eye-table th {\r\n        background: #fbf6ef;\r\n        text-align: center;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        border-color: #f5821f;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .print-format .eye-table:not(.biometry-table) td:first-child {\r\n        font-weight: bold;\r\n        width: 35%;\r\n        color: #16215c;\r\n    }\r\n\r\n    .print-format .eye-table.biometry-table th,\r\n    .print-format .eye-table.biometry-table td {\r\n        line-height: normal !important;\r\n        padding: 6px 8px !important;\r\n    }\r\n\r\n    .print-format .eye-table.biometry-table td:nth-child(2) {\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        font-size: 10px;\r\n        text-align: center;\r\n    }\r\n\r\n    .print-format .eye-table.biometry-table td.highlight-cell {\r\n        font-size: 13px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        text-align: center;\r\n    }\r\n\r\n    .print-format .comments-box {\r\n        border: 1px solid #ccc;\r\n        border-top: none;\r\n        min-height: 50px;\r\n        padding: 6px 8px !important;\r\n        margin-top: 0;\r\n        border-radius: 0 0 6px 6px;\r\n   \r\n    }\r\n\r\n    .print-format .comments-box p {\r\n        margin: 0 0 2px 0 !important;\r\n       \r\n    }\r\n\r\n    .print-format .op-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 0;\r\n        border: 1px solid #ccc;\r\n        border-top: none;\r\n        border-radius: 0 0 6px 6px;\r\n        overflow: hidden;\r\n    }\r\n\r\n    .print-format .op-table td {\r\n        padding: 6px 10px !important;\r\n        font-size: 12px;\r\n        border-bottom: 1px solid #eee;\r\n    }\r\n\r\n    .print-format .op-table td.op-label {\r\n        font-weight: bold;\r\n        color: #16215c;\r\n        width: 35%;\r\n        background: #fbf6ef;\r\n    }\r\n\r\n    .print-format .signature-table {\r\n        width: 100%;\r\n        margin-top: 25px;\r\n    }\r\n\r\n    .print-format .signature-table td {\r\n        border: none;\r\n        text-align: center;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #16215c;\r\n      \r\n    }\r\n\r\n    .print-format .signature-line {\r\n        border-bottom: 2px solid #16215c;\r\n        width: 80%;\r\n        margin: 0 auto 8px;\r\n        height: 1px;\r\n    }\r\n\r\n    .print-format .status-pill {\r\n        display: inline-block;\r\n        margin-top: 6px;\r\n        padding: 2px 10px;\r\n        border-radius: 10px;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .print-format .status-submitted { background: #e4f4e8; color: #1c7a34; }\r\n    .print-format .status-draft     { background: #fdeedb; color: #b45309; }\r\n    .print-format .status-cancelled { background: #fbe4e4; color: #b91c1c; }\r\n</style>\r\n\r\n<main style=\"width: 700px; margin: 0 auto;\">\r\n<div class=\"print-format\">\r\n\r\n    {{ letter_head }}\r\n\r\n    <div class=\"report-title\">Intraocular Lens (IOL) Report</div>\r\n    <div class=\"report-title-underline\"></div>\r\n\r\n    <!-- PATIENT INFO BOX -->\r\n    <div class=\"patient-box\">\r\n        <table class=\"patient-table\">\r\n            <tr>\r\n                <td width=\"50%\">\r\n                    Patient Name : {{ doc.patient_name }}<br>\r\n                    Patient ID : {{ doc.pid }}<br>\r\n                    Sex / Age : {{ doc.sex }} / {{ doc.age }}<br>\r\n                    Practitioner : {{ doc.practitioner or \"\" }}<br>\r\n                </td>\r\n                <td width=\"50%\">\r\n                    Form No : {{ doc.name }}<br>\r\n                    Date : {{ doc.date or \"\" }}<br>\r\n                    Procedure : {{ doc.procedure_template or \"\" }}<br>\r\n                    Printed : {{ frappe.utils.now_datetime() }}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n        {% if doc.docstatus == 1 %}\r\n            <span class=\"status-pill status-submitted\">SUBMITTED</span>\r\n        {% elif doc.docstatus == 2 %}\r\n            <span class=\"status-pill status-cancelled\">CANCELLED</span>\r\n        {% else %}\r\n            <span class=\"status-pill status-draft\">DRAFT</span>\r\n        {% endif %}\r\n    </div>\r\n\r\n    {% if doc.amended_from %}\r\n    <div class=\"comments-box\" style=\"border-radius:6px; border-top:1px solid #ccc; color:#b45309; background:#fdeedb; margin-bottom:10px;\">\r\n        This document amends and supersedes <strong>{{ doc.amended_from }}</strong>.\r\n    </div>\r\n    {% endif %}\r\n\r\n    <!-- OPERATION DETAILS (only if present) -->\r\n    {% if doc.operation_type or doc.operation_category or doc.operation %}\r\n    <div class=\"section-title\">Operation Details</div>\r\n    <table class=\"op-table\">\r\n        {% if doc.operation_type %}\r\n        <tr>\r\n            <td class=\"op-label\">Operation Type</td>\r\n            <td>{{ doc.operation_type }}</td>\r\n        </tr>\r\n        {% endif %}\r\n        {% if doc.operation_category %}\r\n        <tr>\r\n            <td class=\"op-label\">Operation Category</td>\r\n            <td>{{ doc.operation_category }}</td>\r\n        </tr>\r\n        {% endif %}\r\n        {% if doc.operation %}\r\n        <tr>\r\n            <td class=\"op-label\">Operation</td>\r\n            <td>{{ doc.operation }}</td>\r\n        </tr>\r\n        {% endif %}\r\n    </table>\r\n    {% endif %}\r\n\r\n    <!-- IOL BIOMETRY -->\r\n    <div class=\"section-title\">IOL Biometry Examination</div>\r\n\r\n    <table class=\"eye-table\">\r\n        <thead>\r\n            <tr>\r\n                <th>Examination</th>\r\n                <th>Right Eye</th>\r\n                <th>Left Eye</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td>LENS TYPE</td>\r\n                <td>{{ doc.od_type or \"\" }}</td>\r\n                <td>{{ doc.os_type or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>K1</td>\r\n                <td>{{ doc.od_k1 or \"\" }}</td>\r\n                <td>{{ doc.os_k1 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>K2</td>\r\n                <td>{{ doc.od_k2 or \"\" }}</td>\r\n                <td>{{ doc.os_k2 or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>AXIS</td>\r\n                <td>{{ doc.od_axis or \"\" }}</td>\r\n                <td>{{ doc.os_axis or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>AVERAGE AXL</td>\r\n                <td>{{ doc.od_average_axl or \"\" }}</td>\r\n                <td>{{ doc.os_average_axl or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>A-CONSTANT</td>\r\n                <td>{{ doc.od_const_a or \"\" }}</td>\r\n                <td>{{ doc.os_const_a or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td>IOL POWER / SIZE</td>\r\n                <td style=\"font-weight:bold; color:#16215c;\">{{ doc.od_size or \"\" }}</td>\r\n                <td style=\"font-weight:bold; color:#16215c;\">{{ doc.os_size or \"\" }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- SIGNATURE -->\r\n    <table class=\"signature-table\">\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <div class=\"signature-line\"></div>\r\n                Practitioner Signature\r\n            </td>\r\n            <td width=\"50%\">\r\n                <div class=\"signature-line\"></div>\r\n                Patient / Guardian Signature\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>\r\n</main>",
