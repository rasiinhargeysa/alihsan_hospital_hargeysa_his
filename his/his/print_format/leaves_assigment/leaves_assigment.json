 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 9mm 14mm 10mm 14mm;\r\n    }\r\n\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    body {\r\n        margin: 0;\r\n        padding: 0;\r\n        background: #ffffff;\r\n        color: #111111;\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 9.5px;\r\n        line-height: 1.25;\r\n\r\n        -webkit-print-color-adjust: exact !important;\r\n        print-color-adjust: exact !important;\r\n    }\r\n\r\n    .print-container {\r\n        width: 100%;\r\n        max-width: 210mm;\r\n        margin: 0 auto;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       LETTER HEAD\r\n       ===================================================== */\r\n\r\n    .letter-head {\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       DOCUMENT TITLE\r\n       ===================================================== */\r\n\r\n    .document-title {\r\n        text-align: center;\r\n        color: #17245f;\r\n        font-size: 17px;\r\n        font-weight: bold;\r\n        letter-spacing: 1.5px;\r\n        text-transform: uppercase;\r\n        margin: 7px 0 9px 0;\r\n    }\r\n\r\n    .document-title-line {\r\n        width: 120px;\r\n        height: 3px;\r\n        background: #f47721;\r\n        margin: -4px auto 9px auto;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       TOP INFORMATION BOX\r\n       ===================================================== */\r\n\r\n    .info-box {\r\n        width: 100%;\r\n        border: 1px solid #bdbdbd;\r\n        border-radius: 7px;\r\n        padding: 7px 11px;\r\n        margin-bottom: 11px;\r\n    }\r\n\r\n    .info-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .info-table td {\r\n        width: 50%;\r\n        padding: 1px 5px;\r\n        vertical-align: top;\r\n        font-size: 9.5px;\r\n        color: #111111;\r\n    }\r\n\r\n    .info-label {\r\n        font-weight: bold;\r\n        color: #17245f;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       SECTION\r\n       ===================================================== */\r\n\r\n    .section {\r\n        width: 100%;\r\n        margin-bottom: 10px;\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    .section-box {\r\n        width: 100%;\r\n        border: 1px solid #bdbdbd;\r\n        border-radius: 7px;\r\n        overflow: hidden;\r\n    }\r\n\r\n    .section-title {\r\n        background: #f1f1f1;\r\n        border-bottom: 1px solid #bdbdbd;\r\n        padding: 5px 10px;\r\n        color: #17245f;\r\n        font-size: 10px;\r\n        font-weight: bold;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       STANDARD TABLE\r\n       ===================================================== */\r\n\r\n    .data-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .data-table td,\r\n    .data-table th {\r\n        padding: 5px 9px;\r\n        border-bottom: 1px solid #cfcfcf;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .data-table tr:last-child td {\r\n        border-bottom: none;\r\n    }\r\n\r\n    .data-table th {\r\n        background: #fafafa;\r\n        color: #17245f;\r\n        font-weight: bold;\r\n        text-align: left;\r\n        border-bottom: 1px solid #bdbdbd;\r\n    }\r\n\r\n    .label-cell {\r\n        color: #17245f;\r\n        font-weight: bold;\r\n        width: 20%;\r\n    }\r\n\r\n    .value-cell {\r\n        color: #111111;\r\n        width: 30%;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       LEAVE DETAILS\r\n       ===================================================== */\r\n\r\n    .leave-table th {\r\n        text-align: center;\r\n        padding: 5px 7px;\r\n    }\r\n\r\n    .leave-table td {\r\n        text-align: center;\r\n        padding: 6px 7px;\r\n    }\r\n\r\n    .leave-table .leave-type {\r\n        color: #17245f;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .duration {\r\n        color: #f47721 !important;\r\n        font-weight: bold;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       REASON\r\n       ===================================================== */\r\n\r\n    .reason-content {\r\n        padding: 8px 10px;\r\n        min-height: 50px;\r\n        color: #222222;\r\n    }\r\n\r\n    .reason-label {\r\n        color: #17245f;\r\n        font-weight: bold;\r\n        margin-bottom: 4px;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       REQUEST INFORMATION\r\n       ===================================================== */\r\n\r\n    .request-table td {\r\n        padding: 6px 9px;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       APPROVAL\r\n       ===================================================== */\r\n\r\n    .approval-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .approval-table th {\r\n        background: #fafafa;\r\n        color: #17245f;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        padding: 5px;\r\n        border-right: 1px solid #cfcfcf;\r\n        border-bottom: 1px solid #bdbdbd;\r\n    }\r\n\r\n    .approval-table th:last-child {\r\n        border-right: none;\r\n    }\r\n\r\n    .approval-table td {\r\n        height: 68px;\r\n        text-align: center;\r\n        vertical-align: bottom;\r\n        padding: 6px 8px;\r\n        border-right: 1px solid #cfcfcf;\r\n    }\r\n\r\n    .approval-table td:last-child {\r\n        border-right: none;\r\n    }\r\n\r\n    .signature-line {\r\n        width: 80%;\r\n        height: 23px;\r\n        margin: 0 auto 4px auto;\r\n        border-bottom: 1px solid #555555;\r\n    }\r\n\r\n    .signature-name {\r\n        color: #17245f;\r\n        font-size: 9px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .signature-role {\r\n        color: #555555;\r\n        font-size: 8px;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .signature-date {\r\n        color: #555555;\r\n        font-size: 8px;\r\n        margin-top: 4px;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       FOOTER\r\n       ===================================================== */\r\n\r\n    .footer {\r\n        margin-top: 9px;\r\n        padding-top: 5px;\r\n        border-top: 1px solid #d0d0d0;\r\n        color: #777777;\r\n        font-size: 7.5px;\r\n    }\r\n\r\n    .footer-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .footer-left {\r\n        text-align: left;\r\n    }\r\n\r\n    .footer-right {\r\n        text-align: right;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       PRINT\r\n       ===================================================== */\r\n\r\n    @media print {\r\n\r\n        body {\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n\r\n        .section,\r\n        .section-box,\r\n        .info-box {\r\n            page-break-inside: avoid;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n<div class=\"print-container\">\r\n\r\n    <!-- =================================================\r\n         HOSPITAL LETTER HEAD\r\n         ================================================= -->\r\n\r\n    <div class=\"letter-head\">\r\n        {{ letter_head }}\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         DOCUMENT TITLE\r\n         ================================================= -->\r\n\r\n    <div class=\"document-title\">\r\n        Leave Assignment\r\n    </div>\r\n\r\n    <div class=\"document-title-line\"></div>\r\n\r\n\r\n    <!-- =================================================\r\n         EMPLOYEE / REQUEST INFORMATION\r\n         ================================================= -->\r\n\r\n    <div class=\"info-box\">\r\n\r\n        <table class=\"info-table\">\r\n\r\n            <tr>\r\n\r\n                <td>\r\n                    <span class=\"info-label\">Employee ID :</span>\r\n                    {{ doc.employee_id or doc.employee or '\u2014' }}\r\n                </td>\r\n\r\n                <td>\r\n                    <span class=\"info-label\">Leave Ref No :</span>\r\n                    {{ doc.name }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            <tr>\r\n\r\n                <td>\r\n                    <span class=\"info-label\">Employee Name :</span>\r\n                    {{ doc.employee_name or '\u2014' }}\r\n                </td>\r\n\r\n                <td>\r\n                    <span class=\"info-label\">Leave Type :</span>\r\n                    {{ doc.leave_type or '\u2014' }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            <tr>\r\n\r\n                <td>\r\n                    <span class=\"info-label\">Submitted By :</span>\r\n                    {{ doc.owner_full_name or doc.owner or '\u2014' }}\r\n                </td>\r\n\r\n                <td>\r\n                    <span class=\"info-label\">Request Date :</span>\r\n\r\n                    {% if doc.creation %}\r\n                        {{ frappe.utils.formatdate(doc.creation) }}\r\n                    {% else %}\r\n                        \u2014\r\n                    {% endif %}\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         LEAVE DETAILS\r\n         ================================================= -->\r\n\r\n    <div class=\"section\">\r\n\r\n        <div class=\"section-box\">\r\n\r\n            <div class=\"section-title\">\r\n                Leave Details\r\n            </div>\r\n\r\n            <table class=\"data-table leave-table\">\r\n\r\n                <thead>\r\n\r\n                    <tr>\r\n\r\n                        <th style=\"width:25%;\">\r\n                            Leave Type\r\n                        </th>\r\n\r\n                        <th style=\"width:25%;\">\r\n                            From Date\r\n                        </th>\r\n\r\n                        <th style=\"width:25%;\">\r\n                            To Date\r\n                        </th>\r\n\r\n                        <th style=\"width:25%;\">\r\n                            Duration\r\n                        </th>\r\n\r\n                    </tr>\r\n\r\n                </thead>\r\n\r\n                <tbody>\r\n\r\n                    <tr>\r\n\r\n                        <td class=\"leave-type\">\r\n                            {{ doc.leave_type or '\u2014' }}\r\n                        </td>\r\n\r\n                        <td>\r\n\r\n                            {% if doc.from_date %}\r\n                                {{ frappe.utils.formatdate(doc.from_date) }}\r\n                            {% else %}\r\n                                \u2014\r\n                            {% endif %}\r\n\r\n                        </td>\r\n\r\n                        <td>\r\n\r\n                            {% if doc.to_date %}\r\n                                {{ frappe.utils.formatdate(doc.to_date) }}\r\n                            {% else %}\r\n                                \u2014\r\n                            {% endif %}\r\n\r\n                        </td>\r\n\r\n                       <td class=\"duration\">\r\n\r\n                            {% if doc.total_leave_days %}\r\n                                {{ doc.total_leave_days }}\r\n                            {% elif doc.from_date and doc.to_date %}\r\n                                {{ frappe.utils.date_diff(doc.to_date, doc.from_date) + 1 }}\r\n                            {% else %}\r\n                                0\r\n                            {% endif %}\r\n                        \r\n                            Day(s)\r\n\r\n</td>\r\n\r\n                    </tr>\r\n\r\n                </tbody>\r\n\r\n            </table>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         EMPLOYEE INFORMATION\r\n         ================================================= -->\r\n\r\n    <div class=\"section\">\r\n\r\n        <div class=\"section-box\">\r\n\r\n            <div class=\"section-title\">\r\n                Employee Information\r\n            </div>\r\n\r\n            <table class=\"data-table\">\r\n\r\n                <tbody>\r\n\r\n                    <tr>\r\n\r\n                        <td class=\"label-cell\">\r\n                            Employee\r\n                        </td>\r\n\r\n                        <td class=\"value-cell\">\r\n                            {{ doc.employee or '\u2014' }}\r\n                        </td>\r\n\r\n                        <td class=\"label-cell\">\r\n                            Employee ID\r\n                        </td>\r\n\r\n                        <td class=\"value-cell\">\r\n                            {{ doc.employee_id or '\u2014' }}\r\n                        </td>\r\n\r\n                    </tr>\r\n\r\n                    <tr>\r\n\r\n                        <td class=\"label-cell\">\r\n                            Employee Name\r\n                        </td>\r\n\r\n                        <td colspan=\"3\">\r\n                            {{ doc.employee_name or '\u2014' }}\r\n                        </td>\r\n\r\n                    </tr>\r\n\r\n                </tbody>\r\n\r\n            </table>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         REASON FOR LEAVE\r\n         ================================================= -->\r\n\r\n    <div class=\"section\">\r\n\r\n        <div class=\"section-box\">\r\n\r\n            <div class=\"section-title\">\r\n                Reason for Leave\r\n            </div>\r\n\r\n            <div class=\"reason-content\">\r\n\r\n                <div class=\"reason-label\">\r\n                    Reason\r\n                </div>\r\n\r\n                {{ doc.reason or 'Personal leave' }}\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         REQUEST INFORMATION\r\n         ================================================= -->\r\n\r\n    <div class=\"section\">\r\n\r\n        <div class=\"section-box\">\r\n\r\n            <div class=\"section-title\">\r\n                Request Information\r\n            </div>\r\n\r\n            <table class=\"data-table request-table\">\r\n\r\n                <tbody>\r\n\r\n                    <tr>\r\n\r\n                        <td class=\"label-cell\">\r\n                            User\r\n                        </td>\r\n\r\n                        <td class=\"value-cell\">\r\n                            {{ doc.owner or '\u2014' }}\r\n                        </td>\r\n\r\n                        <td class=\"label-cell\">\r\n                            User Full Name\r\n                        </td>\r\n\r\n                        <td class=\"value-cell\">\r\n                            {{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or '\u2014' }}\r\n                        </td>\r\n\r\n                    </tr>\r\n\r\n                </tbody>\r\n\r\n            </table>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         APPROVAL & SIGNATURES\r\n         ================================================= -->\r\n\r\n    <div class=\"section\">\r\n\r\n        <div class=\"section-box\">\r\n\r\n            <div class=\"section-title\">\r\n                Approval &amp; Signatures\r\n            </div>\r\n\r\n            <table class=\"approval-table\">\r\n\r\n                <thead>\r\n\r\n                    <tr>\r\n\r\n                        <th>\r\n                            Employee\r\n                        </th>\r\n\r\n                        <th>\r\n                            Supervisor\r\n                        </th>\r\n\r\n                        <th>\r\n                            Human Resources\r\n                        </th>\r\n\r\n                    </tr>\r\n\r\n                </thead>\r\n\r\n                <tbody>\r\n\r\n                    <tr>\r\n\r\n                        <td>\r\n\r\n                            <div class=\"signature-line\"></div>\r\n\r\n                            <div class=\"signature-name\">\r\n                                {{ doc.employee_name or 'Employee Name' }}\r\n                            </div>\r\n\r\n                            <div class=\"signature-role\">\r\n                                Employee\r\n                            </div>\r\n\r\n                            <div class=\"signature-date\">\r\n                                Date: __________________\r\n                            </div>\r\n\r\n                        </td>\r\n\r\n                        <td>\r\n\r\n                            <div class=\"signature-line\"></div>\r\n\r\n                            <div class=\"signature-name\">\r\n                                Supervisor\r\n                            </div>\r\n\r\n                            <div class=\"signature-role\">\r\n                                Supervisor / Manager\r\n                            </div>\r\n\r\n                            <div class=\"signature-date\">\r\n                                Date: __________________\r\n                            </div>\r\n\r\n                        </td>\r\n\r\n                        <td>\r\n\r\n                            <div class=\"signature-line\"></div>\r\n\r\n                            <div class=\"signature-name\">\r\n                                HR Department\r\n                            </div>\r\n\r\n                            <div class=\"signature-role\">\r\n                                Human Resources\r\n                            </div>\r\n\r\n                            <div class=\"signature-date\">\r\n                                Date: __________________\r\n                            </div>\r\n\r\n                        </td>\r\n\r\n                    </tr>\r\n\r\n                </tbody>\r\n\r\n            </table>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- =================================================\r\n         FOOTER\r\n         ================================================= -->\r\n\r\n    <div class=\"footer\">\r\n\r\n        <table class=\"footer-table\">\r\n\r\n            <tr>\r\n\r\n                <td class=\"footer-left\">\r\n                    Al Ihsan Specialist Hospital\r\n                </td>\r\n\r\n                <td class=\"footer-right\">\r\n                    {{ doc.name }} &nbsp; | &nbsp; Leave Assignment\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n</div>",
